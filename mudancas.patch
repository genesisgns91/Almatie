ng: 8px;\n  border: 1px solid var(--border);\n  border-bottom: none;\n  border-radius: var(--radius-sm) var(--radius-sm) 0 0;\n  overflow-x: auto;\n  scrollbar-width: none;\n  -webkit-overflow-scrolling: touch;\n}\n\n.editor-toolbar::-webkit-scrollbar { display: none; }\n\n.editor-toolbar > * { flex: none; }\n\n.editor-toolbar button {\n  min-width: 38px;\n  height: 38px;\n  padding: 0 11px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 9px;\n  cursor: pointer;\n  font: 600 0.85rem/1 var(--font-body);\n  color: var(--text);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  transition: var(--transition);\n  -webkit-user-select: none;\n  user-select: none;\n}\n\n.editor-toolbar button:hover { border-color: var(--primary); color: var(--primary-hover); }\n\n.editor-toolbar button.ativo {\n  background: var(--primary-soft);\n  border-color: var(--primary);\n  color: var(--primary-hover);\n}\n\n.editor-toolbar-divisor {\n  width: 1px;\n  height: 22px;\n  background: var(--border);\n  margin: 0 2px;\n}\n\n.editor-toolbar .editor-cor {\n  min-width: 28px;\n  width: 28px;\n  height: 28px;\n  padding: 0;\n  border-radius: 50%;\n  background: var(--cor);\n  border: 2px solid #fff;\n  box-shadow: 0 0 0 1px var(--border);\n}\n\n.editor-toolbar .editor-cor:hover { border-color: #fff; box-shadow: 0 0 0 2px var(--cor); }\n\n.editor-content {\n  min-height: 160px;\n  max-height: 340px;\n  border: 1px solid var(--border);\n  border-radius: 0 0 var(--radius-sm) var(--radius-sm);\n  padding: 12px;\n  background: var(--surface);\n  outline: none;\n  overflow-y: auto;\n  resize: vertical;\n  font-size: 1rem;\n  line-height: 1.55;\n  transition: border-color var(--transition);\n  -webkit-user-select: text;\n  user-select: text;\n}\n\n.editor-content:focus { border-color: var(--primary); box-shadow: var(--focus-ring); }\n\n.editor-content.vazio::before { content: attr(data-placeholder); color: var(--text-muted); pointer-events: none; }\n\n.editor-content a { color: var(--primary-hover); text-decoration: underline; }\n\n.editor-content h3 { font-family: var(--font-body); font-size: 1.05rem; margin: 6px 0 2px; }\n\n.editor-content ul, .editor-content ol { padding-left: 22px; margin: 4px 0; }\n\n.editor-hint { margin-top: 6px; display: block; }\n\n.select-custom {\n  padding: 10px 12px;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  font-size: 0.9rem;\n  background: var(--surface);\n  color: var(--text);\n  outline: none;\n}\n\n.tags-taxonomia-container {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-top: 8px;\n}\n\n.badge-taxonomia {\n  font-size: 0.75rem;\n  background: var(--bg-alt);\n  border: 1px solid var(--border);\n  padding: 3px 8px;\n  border-radius: 12px;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.badge-taxonomia button {\n  background: none;\n  border: none;\n  color: var(--danger);\n  cursor: pointer;\n  font-weight: bold;\n}\n\n.campo-moeda-wrap {\n  position: relative;\n}\n\n.campo-moeda-wrap .prefixo-moeda {\n  position: absolute;\n  left: 12px;\n  top: 50%;\n  transform: translateY(-50%);\n  color: var(--text-muted);\n  font-weight: 700;\n  font-size: 0.85rem;\n  pointer-events: none;\n}\n\n.campo-moeda-wrap input {\n  padding-left: 34px;\n}\n\n.check-destaque {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 12px;\n  background: var(--primary-soft);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  font-size: 0.85rem;\n  cursor: pointer;\n}\n\n.check-destaque input {\n  width: auto;\n  accent-color: var(--primary);\n}\n\n.acoes-admin {\n  flex-wrap: wrap;\n}\n\n.btn-destacar {\n  flex: 1 1 100%;\n  padding: 6px 4px;\n  font-size: 0.75rem;\n  font-weight: 600;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--primary);\n  background: var(--primary-soft);\n  color: var(--primary-hover);\n  cursor: pointer;\n  transition: var(--transition);\n}\n\n.btn-destacar:hover {\n  background: var(--primary);\n  color: #fff;\n}\n\n@media (max-width: 640px) {\n.acoes-admin button { min-height: 40px; }\n\n.painel-admin { max-width: none; margin: 12px; padding: 18px 16px; border-radius: 20px; }\n\n.secao-personalizacao { padding: 14px; }\n\n.secao-personalizacao summary { min-height: 28px; }\n\n.editor-content { min-height: 180px; }\n\n}\n\n.lista-pedidos { display: flex; flex-direction: column; gap: 10px; }\n\n.pedido-item {\n  display: flex; flex-direction: column; gap: 8px;\n  padding: 12px 14px; background: var(--surface);\n  border: 1px solid var(--border); border-radius: 12px;\n}\n\n.pedido-topo { display: flex; justify-content: space-between; gap: 10px; font-size: 0.9rem; }\n\n.pedido-topo span { color: var(--primary-hover); font-weight: 700; white-space: nowrap; }\n\n.pedido-etiquetas { display: flex; flex-wrap: wrap; gap: 6px; }\n\n.pedido-tag { font-size: 0.68rem; font-weight: 700; padding: 3px 9px; border-radius: var(--radius-full); background: var(--bg-alt); color: var(--text-muted); }\n\n.pedido-tag.ok { background: #DDF3E4; color: #1E6B3A; }\n\n.pedido-tag.alerta { background: #FFF1D6; color: #8A5A00; }\n\n.pedido-tag.erro { background: #FBE0E0; color: #A12626; }\n\n.pedido-info { font-size: 0.75rem; color: var(--text-muted); word-break: break-word; }\n\n.pedido-item .btn-link { align-self: flex-start; }\n\n.item-img-grid { cursor: grab; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }\n\n.item-img-grid img { pointer-events: none; -webkit-user-drag: none; }\n\n.item-img-grid.arrastando-origem { opacity: 0.35; outline: 2px dashed var(--primary); outline-offset: -2px; }\n\n.arrastando-fantasma {\n  position: fixed;\n  z-index: 2000;\n  margin: 0;\n  pointer-events: none;\n  opacity: 0.94;\n  box-shadow: var(--shadow-lg);\n  transform: scale(1.07) rotate(2deg);\n}\n\nbody.ordenando-imagens { cursor: grabbing; -webkit-user-select: none; user-select: none; }\n\n.num-img {\n  position: absolute; left: 4px; bottom: 4px;\n  min-width: 20px; height: 20px; padding: 0 7px;\n  border-radius: var(--radius-full);\n  background: rgba(27, 18, 48, 0.72); color: #fff;\n  font: 700 0.68rem/20px var(--font-body); text-align: center;\n  pointer-events: none;\n}\n\n.num-img.capa { background: var(--primary); }\n\n.btn-primeira-img {\n  position: absolute; top: 4px; left: 4px;\n  width: 22px; height: 22px; padding: 0;\n  border: none; border-radius: 50%;\n  background: rgba(27, 18, 48, 0.72); color: #fff;\n  font-size: 13px; font-weight: 700; line-height: 1;\n  cursor: pointer;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.btn-primeira-img:hover { background: var(--primary); }\n\n.editor-toolbar .btn-ia { background: var(--gradient-ink); color: #fff; border-color: transparent; padding: 0 14px; }\n\n.editor-toolbar .btn-ia:hover { color: #fff; filter: brightness(1.08); }\n\n.editor-toolbar .btn-ia:disabled { opacity: 0.7; cursor: wait; }\n\n.detalhes-ia { margin-top: 10px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); padding: 10px 12px; font-size: 0.8rem; }\n\n.detalhes-ia summary { cursor: pointer; font-weight: 600; color: var(--primary-hover); }\n\n.detalhes-ia pre { margin: 10px 0; max-height: 220px; overflow: auto; white-space: pre-wrap; word-break: break-word; font: 0.72rem/1.5 ui-monospace, Consolas, monospace; color: var(--text-muted); -webkit-user-select: text; user-select: text; }\n\n\n/* =====================================================================\n   PAINEL DE GESTÃO — layout para tela larga\n   Colunas lado a lado (dados | texto | imagens), abas para as demais seções,\n   e altura que se ajusta à tela para o painel inteiro caber sem rolagem.\n   ===================================================================== */\n#painelAdmin.painel-admin {\n  max-width: none;\n  margin: 14px clamp(10px, 1.6vw, 32px) 22px;\n  padding: 0;\n  border-radius: 18px;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  background: var(--surface);\n}\n\n/* --- barra de cima: título, abas e sair --- */\n#painelAdmin .painel-topo {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 8px clamp(14px, 1.8vw, 28px) 0;\n  background: var(--surface);\n  border-bottom: 1px solid var(--border);\n  flex: none;\n}\n#painelAdmin .painel-titulo { display: flex; align-items: center; gap: 10px; flex: none; padding-bottom: 8px; }\n#painelAdmin .painel-titulo h3 { display: block; margin: 0; font-size: 1.05rem; white-space: nowrap; }\n#painelAdmin .painel-estado {\n  padding: 3px 11px;\n  border-radius: var(--radius-full);\n  background: var(--primary-soft);\n  color: var(--primary-hover);\n  font-size: 0.76rem;\n  font-weight: 700;\n  max-width: 34ch;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n#painelAdmin .painel-abas {\n  display: flex;\n  gap: 2px;\n  flex: 1;\n  min-width: 0;\n  align-self: flex-end;\n  overflow-x: auto;\n  scrollbar-width: none;\n}\n#painelAdmin .painel-abas::-webkit-scrollbar { display: none; }\n#painelAdmin .painel-aba-btn {\n  flex: none;\n  border: 0;\n  border-bottom: 3px solid transparent;\n  border-radius: 10px 10px 0 0;\n  background: transparent;\n  padding: 12px 16px 11px;\n  color: var(--text-muted);\n  font: 600 0.9rem/1 var(--font-body);\n  cursor: pointer;\n  transition: color 0.15s, background-color 0.15s, border-color 0.15s;\n}\n#painelAdmin .painel-aba-btn:hover { color: var(--text); background: var(--bg-alt); }\n#painelAdmin .painel-aba-btn.ativa { color: var(--primary-hover); border-bottom-color: var(--primary); }\n#painelAdmin .painel-aba-btn:focus-visible { outline: 3px solid var(--primary-soft); outline-offset: -3px; }\n#painelAdmin #btnFazerLogout { flex: none; align-self: center; margin-bottom: 6px; }\n\n/* --- seções --- */\n#painelAdmin .painel-secao {\n  display: none;\n  flex-direction: column;\n  gap: clamp(12px, 1.2vw, 18px);\n  padding: clamp(12px, 1.4vw, 22px) clamp(12px, 1.8vw, 28px) clamp(14px, 1.6vw, 24px);\n  background: var(--bg);\n}\n#painelAdmin .painel-secao.ativa { display: flex; }\n\n#painelAdmin .anuncio-col {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  padding: 16px 18px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 14px;\n}\n#painelAdmin .anuncio-subtitulo {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  margin: 0 0 12px;\n  font-family: var(--font-body);\n  font-size: 0.74rem;\n  font-weight: 700;\n  letter-spacing: 0.09em;\n  text-transform: uppercase;\n  color: var(--text-muted);\n  flex: none;\n}\n\n/* --- anúncio: campos em duas colunas --- */\n#painelAdmin .anuncio-grid { display: grid; gap: clamp(12px, 1.2vw, 18px); grid-template-columns: minmax(0, 1fr); }\n#painelAdmin .campos-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2px 12px; }\n#painelAdmin .campos-grid .form-group { min-width: 0; margin-bottom: 8px; }\n#painelAdmin .campos-grid .campo-largo { grid-column: 1 / -1; }\n#painelAdmin .campos-grid .campo-valor-group { flex: initial; }\n#painelAdmin .campos-grid .check-destaque { margin-top: 2px; }\n\n#painelAdmin .anuncio-texto .editor-wrap { flex: 1; min-height: 0; }\n#painelAdmin .anuncio-texto .editor-content { min-height: 200px; }\n#painelAdmin .anuncio-imagens .grid-imagens-modal {\n  flex: 1;\n  min-height: 160px;\n  max-height: 420px;\n  margin-top: 0;\n  grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));\n}\n#painelAdmin .anuncio-imagens .hint { margin-top: 8px; flex: none; }\n\n/* --- botões de ação no rodapé --- */\n#painelAdmin .painel-acoes {\n  display: flex;\n  justify-content: flex-end;\n  align-items: center;\n  gap: 12px;\n  flex: none;\n}\n#painelAdmin .painel-acoes .btn { width: auto; min-width: 210px; }\n\n/* --- pedidos --- */\n#painelAdmin .pedidos-topo { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex: none; }\n#painelAdmin .pedidos-topo .btn { width: auto; }\n#painelAdmin .lista-pedidos {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));\n  gap: 12px;\n  align-content: start;\n  min-height: 0;\n}\n\n/* --- categorias --- */\n#painelAdmin .categorias-campos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) auto; gap: 12px; align-items: end; }\n#painelAdmin .categorias-campos .form-group { margin-bottom: 0; }\n#painelAdmin .categorias-campos .btn { width: auto; white-space: nowrap; }\n#painelAdmin .categorias-lista { min-height: 120px; }\n#painelAdmin .categorias-lista .tags-taxonomia-container { margin-top: 0; }\n\n/* --- identidade --- */\n#painelAdmin .identidade-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: clamp(12px, 1.2vw, 18px); }\n#painelAdmin .identidade-grid .preview-box { width: 150px; height: 96px; }\n#painelAdmin .identidade-grid .preview-favicon { width: 72px; height: 72px; }\n#painelAdmin .identidade-grid .preview-box img { max-width: 100%; max-height: 100%; object-fit: contain; }\n\n/* --- a partir de 900px: dados à esquerda; texto e imagens à direita --- */\n@media (min-width: 900px) {\n  #painelAdmin .anuncio-grid {\n    grid-template-columns: minmax(320px, 400px) minmax(0, 1fr);\n    grid-template-areas: \"dados texto\" \"dados imagens\";\n  }\n  #painelAdmin .anuncio-dados { grid-area: dados; }\n  #painelAdmin .anuncio-texto { grid-area: texto; }\n  #painelAdmin .anuncio-imagens { grid-area: imagens; }\n  #painelAdmin .editor-toolbar { flex-wrap: wrap; overflow: visible; }\n}\n\n/* --- a partir de 1280px: três colunas lado a lado --- */\n@media (min-width: 1280px) {\n  #painelAdmin .anuncio-grid {\n    grid-template-columns: minmax(330px, 400px) minmax(0, 1.3fr) minmax(300px, 1fr);\n    grid-template-areas: \"dados texto imagens\";\n  }\n}\n\n/* --- tela larga e com altura boa: o painel ocupa a tela toda, sem rolagem de página --- */\n@media (min-width: 1280px) and (min-height: 700px) {\n  #painelAdmin.painel-admin { height: calc(100vh - var(--appbar-h, 76px) - 36px); height: calc(100dvh - var(--appbar-h, 76px) - 36px); }\n  #painelAdmin .painel-secao.ativa { flex: 1; min-height: 0; overflow-y: auto; }\n  #painelAdmin #painelAnuncio.ativa { overflow: hidden; }\n  #painelAdmin .anuncio-grid { flex: 1; min-height: 0; grid-template-rows: minmax(0, 1fr); }\n  #painelAdmin .anuncio-dados { overflow-y: auto; }\n  #painelAdmin .anuncio-texto, #painelAdmin .anuncio-imagens { overflow: hidden; }\n  #painelAdmin .anuncio-texto .editor-content { flex: 1; min-height: 0; max-height: none; resize: none; }\n  #painelAdmin .anuncio-imagens .grid-imagens-modal { max-height: none; min-height: 0; }\n  #painelAdmin #painelPedidos.ativa { overflow: hidden; }\n  #painelAdmin #painelPedidos .lista-pedidos { flex: 1; overflow-y: auto; }\n}\n\n/* --- celular e tablet --- */\n@media (max-width: 899px) {\n  #painelAdmin.painel-admin { margin: 10px; border-radius: 16px; }\n  #painelAdmin .painel-topo { flex-wrap: wrap; gap: 4px 12px; padding-top: 10px; }\n  #painelAdmin .painel-abas { order: 3; flex: 1 1 100%; }\n  #painelAdmin #btnFazerLogout { margin-left: auto; margin-bottom: 8px; }\n  #painelAdmin .painel-acoes { flex-direction: column-reverse; align-items: stretch; }\n  #painelAdmin .painel-acoes .btn { width: 100%; min-width: 0; }\n  #painelAdmin .pedidos-topo { flex-direction: column; align-items: stretch; }\n  #painelAdmin .pedidos-topo .btn { width: 100%; }\n  #painelAdmin .categorias-campos { grid-template-columns: 1fr; }\n  #painelAdmin .categorias-campos .btn { width: 100%; margin-top: 4px; }\n}\n\n\n/* --- ajustes de densidade e de detalhes --- */\n#painelAdmin .editor-toolbar { gap: 6px 12px; padding: 8px 10px; }\n#painelAdmin .editor-grupo { display: inline-flex; align-items: center; gap: 5px; }\n#painelAdmin .editor-toolbar button { min-width: 34px; height: 34px; padding: 0 10px; font-size: 0.82rem; }\n#painelAdmin .editor-toolbar .editor-cor { min-width: 26px; width: 26px; height: 26px; padding: 0; }\n#painelAdmin .editor-toolbar .btn-ia { padding: 0 13px; }\n#painelAdmin .editor-content, #painelAdmin .editor-content p, #painelAdmin .editor-content div, #painelAdmin .editor-content li { color: var(--text); }\n\n/* a grade de imagens nunca \"espreme\" as miniaturas: elas mantêm o quadrado e a lista rola */\n#painelAdmin .grid-imagens-modal { align-content: start; grid-auto-rows: max-content; }\n\n@media (min-width: 900px) {\n  #painelAdmin .campos-grid .form-group { margin-bottom: 6px; gap: 3px; }\n  #painelAdmin .campos-grid label { font-size: 0.78rem; }\n  #painelAdmin .campos-grid input:not([type=\"checkbox\"]), #painelAdmin .campos-grid select { padding-top: 8px; padding-bottom: 8px; min-height: 38px; }\n  #painelAdmin .campos-grid .hint { font-size: 0.7rem; line-height: 1.3; }\n  #painelAdmin .anuncio-subtitulo { margin-bottom: 10px; }\n  #painelAdmin .anuncio-col { padding: 14px 16px; }\n}\n\n\n/* --- dicas dentro do rótulo, para a coluna de dados caber na tela --- */\n#painelAdmin .campos-grid label { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }\n#painelAdmin .dica-rotulo { font-size: 0.68rem; font-weight: 500; color: var(--text-muted); text-align: right; }\n#painelAdmin .dica-rotulo.dica-destaque { font-weight: 800; color: var(--primary-hover); }\n#painelAdmin .campo-destaque .check-destaque { flex: 1; margin: 0; min-height: 38px; align-items: center; font-size: 0.82rem; }\n\n\n/* --- em tela larga, \"Publicar\" e \"Cancelar\" ficam na barra de cima: sempre à vista e sem gastar altura --- */\n@media (min-width: 1200px) {\n  #painelAdmin.painel-admin { position: relative; }\n  #painelAdmin #painelAnuncio .painel-acoes { position: absolute; top: 7px; right: 86px; padding: 0; gap: 8px; }\n  #painelAdmin #painelAnuncio .painel-acoes .btn { min-width: 0; padding: 9px 18px; }\n}\n\n/* telas baixas (ex.: 1280x720): campos um pouco mais compactos para caber sem rolagem */\n@media (min-width: 900px) and (max-height: 760px) {\n  #painelAdmin .campos-grid .form-group { margin-bottom: 3px; gap: 2px; }\n  #painelAdmin .campos-grid input:not([type=\"checkbox\"]), #painelAdmin .campos-grid select { padding-top: 6px; padding-bottom: 6px; min-height: 34px; }\n  #painelAdmin .campo-destaque .check-destaque { min-height: 34px; }\n  #painelAdmin .anuncio-col { padding: 12px 14px; }\n  #painelAdmin .anuncio-subtitulo { margin-bottom: 8px; }\n  #painelAdmin .painel-secao { padding-top: 10px; padding-bottom: 12px; }\n}\n\n#painelAdmin .anuncio-subtitulo .painel-estado { text-transform: none; letter-spacing: 0; }\n\n/* botões secundários do painel com contorno, para ficarem visíveis sobre o fundo claro */\n#painelAdmin .btn-secondary { background: var(--surface); border: 1px solid var(--border); color: var(--text); }\n#painelAdmin .btn-secondary:hover { border-color: var(--primary); color: var(--primary-hover); }\n\n\n/* =====================================================================\n   IDENTIDADE DA LOJA: marca, cores e faixa de destaque\n   ===================================================================== */\n#painelAdmin .identidade-grid { display: grid; gap: clamp(12px, 1.2vw, 18px); grid-template-columns: minmax(0, 1fr); align-items: start; }\n#painelAdmin .id-marca { grid-area: marca; }\n#painelAdmin .id-cores { grid-area: cores; }\n#painelAdmin .id-faixa { grid-area: faixa; position: relative; }\n#painelAdmin .identidade-grid { grid-template-areas: \"marca\" \"cores\" \"faixa\"; }\n\n@media (min-width: 900px) {\n  #painelAdmin .identidade-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); grid-template-areas: \"marca faixa\" \"cores faixa\"; }\n}\n@media (min-width: 1280px) {\n  #painelAdmin .identidade-grid { grid-template-columns: minmax(270px, 0.9fr) minmax(290px, 1fr) minmax(400px, 1.55fr); grid-template-areas: \"marca cores faixa\"; }\n}\n\n/* marca */\n#painelAdmin .id-marca .form-group, #painelAdmin .id-faixa .form-group { margin-bottom: 10px; }\n#painelAdmin .id-marca label, #painelAdmin .id-faixa .form-group label { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }\n#painelAdmin .marca-imagens { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: 6px; }\n#painelAdmin .marca-imagens .upload-preview-container { flex-direction: column; align-items: stretch; gap: 8px; }\n#painelAdmin .marca-imagens .preview-box { width: 100%; height: 84px; }\n#painelAdmin .marca-imagens .preview-favicon { width: 100%; height: 84px; }\n#painelAdmin .marca-imagens .preview-box img { max-width: 100%; max-height: 100%; object-fit: contain; }\n#painelAdmin .marca-imagens .btn { width: 100%; }\n\n/* cores */\n#painelAdmin .cor-linha { display: grid; grid-template-columns: minmax(0, 1fr) 46px 92px; gap: 8px; align-items: center; margin-bottom: 10px; }\n#painelAdmin .cor-linha label { display: flex; flex-direction: column; gap: 1px; font-size: 0.85rem; font-weight: 600; line-height: 1.25; margin: 0; }\n#painelAdmin .dica-rotulo { font-size: 0.68rem; font-weight: 500; color: var(--text-muted); }\n#painelAdmin .cor-linha input[type=\"color\"] { width: 46px; height: 38px; padding: 2px; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); cursor: pointer; }\n#painelAdmin .cor-linha input[type=\"text\"] { min-height: 38px; padding: 6px 8px; font: 600 0.82rem/1 ui-monospace, Consolas, monospace; text-transform: uppercase; text-align: center; }\n#painelAdmin input.invalido { border-color: var(--danger); box-shadow: 0 0 0 3px var(--danger-soft); }\n#painelAdmin .cor-aviso { margin: 4px 0 8px; padding: 10px 12px; border-radius: 10px; background: var(--bg); font-size: 0.76rem; line-height: 1.55; color: var(--text); }\n\n/* faixa */\n#painelAdmin .cfg-previa { margin: 8px 0 12px; max-width: none; padding: 12px 16px; min-height: 64px; }\n#painelAdmin .cfg-previa.previa-oculta { opacity: 0.4; filter: grayscale(0.6); }\n#painelAdmin .cfg-previa.previa-oculta::after { content: \"oculta na loja\"; display: block; position: absolute; left: 12px; bottom: 6px; padding: 1px 8px; border-radius: 999px; background: rgba(0, 0, 0, 0.55); color: #fff; font-size: 0.62rem; }\n#painelAdmin .id-faixa textarea { resize: vertical; min-height: 56px; }\n#painelAdmin .faixa-cores { margin: 2px 0 12px; }\n#painelAdmin .faixa-cores-campos { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 8px; }\n#painelAdmin .cor-mini { display: inline-flex; align-items: center; gap: 8px; font-size: 0.8rem; font-weight: 600; margin: 0; }\n#painelAdmin .cor-mini input[type=\"color\"] { width: 40px; height: 32px; padding: 2px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); cursor: pointer; }\n#painelAdmin .cor-mini input:disabled { opacity: 0.4; cursor: not-allowed; }\n\n#painelAdmin .botoes-cabecalho { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin: 4px 0 8px; font-size: 0.85rem; }\n#painelAdmin .botoes-lista { display: flex; flex-direction: column; gap: 8px; margin-bottom: 10px; }\n#painelAdmin .botao-linha { display: grid; grid-template-columns: 46px minmax(70px, 120px) minmax(0, 1fr) auto; gap: 8px; align-items: center; padding: 8px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg); }\n#painelAdmin .botao-linha input { min-height: 38px; padding: 6px 10px; font-size: 0.85rem; min-width: 0; }\n#painelAdmin .botao-icone, #painelAdmin .icone-opcao {\n  width: 44px; height: 44px; padding: 0;\n  display: inline-flex; align-items: center; justify-content: center;\n  border: 0; border-radius: 12px; cursor: pointer;\n  background: var(--gradient-ink); color: #fff;\n}\n#painelAdmin .botao-icone:hover { filter: brightness(1.1); }\n#painelAdmin .botao-icone svg, #painelAdmin .icone-opcao svg { width: 21px; height: 21px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }\n#painelAdmin .botao-icone img, #painelAdmin .icone-opcao img { width: 22px; height: 22px; object-fit: contain; }\n#painelAdmin .botao-icone .hero-emoji, #painelAdmin .icone-opcao .hero-emoji { font-size: 1.25rem; }\n#painelAdmin .botao-acoes { display: inline-flex; gap: 4px; }\n#painelAdmin .botao-acoes button { width: 30px; height: 30px; padding: 0; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); font-size: 0.7rem; cursor: pointer; }\n#painelAdmin .botao-acoes button:hover:not(:disabled) { border-color: var(--primary); color: var(--primary-hover); }\n#painelAdmin .botao-acoes button:disabled { opacity: 0.35; cursor: default; }\n#painelAdmin .botao-acoes button:last-child:hover:not(:disabled) { border-color: var(--danger); color: var(--danger); }\n#painelAdmin #cfgAddBotao { width: auto; align-self: flex-start; }\n\n#painelAdmin .botoes-lista .seletor-icone { margin: -2px 0 2px; }\n#painelAdmin .seletor-icone { margin-top: 12px; padding: 14px; border: 1px solid var(--primary); border-radius: 14px; background: var(--surface); box-shadow: var(--shadow); }\n#painelAdmin .seletor-grade { display: grid; grid-template-columns: repeat(auto-fill, minmax(44px, 1fr)); gap: 8px; }\n#painelAdmin .icone-opcao { width: 100%; background: var(--bg-alt); color: var(--text); }\n#painelAdmin .icone-opcao:hover { background: var(--primary-soft); color: var(--primary-hover); }\n#painelAdmin .icone-opcao.ativo { background: var(--gradient-ink); color: #fff; }\n#painelAdmin .seletor-extra { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-top: 12px; }\n#painelAdmin .seletor-emoji { display: inline-flex; align-items: center; gap: 8px; font-size: 0.8rem; font-weight: 600; margin: 0; }\n#painelAdmin .seletor-emoji input { width: 70px; min-height: 36px; padding: 4px 8px; text-align: center; font-size: 1.1rem; }\n\n/* \"Salvar\" no mesmo lugar do \"Publicar\": na barra de cima em tela larga */\n#painelAdmin #painelIdentidade .painel-acoes { gap: 10px; }\n@media (min-width: 1200px) {\n  #painelAdmin #painelIdentidade .painel-acoes { position: absolute; top: 7px; right: 86px; padding: 0; }\n  #painelAdmin #painelIdentidade .painel-acoes .btn { min-width: 0; padding: 9px 18px; }\n  #painelAdmin #painelIdentidade .painel-acoes .hint { margin: 0 6px 0 0; color: var(--primary-hover); font-weight: 700; }\n}\n@media (max-width: 899px) {\n  #painelAdmin .botao-linha { grid-template-columns: 46px minmax(0, 1fr) auto; }\n  #painelAdmin .botao-linha input:nth-of-type(2) { grid-column: 1 / -1; grid-row: 2; }\n  #painelAdmin .cor-linha { grid-template-columns: minmax(0, 1fr) 46px 84px; }\n}\n",
-  html: "  <div id=\"painelAdmin\" class=\"painel-admin\">\n    <header class=\"painel-topo\">\n      <div class=\"painel-titulo\">\n        <h3 id=\"tituloPainel\">Painel de Gestão</h3>\n      </div>\n      <nav class=\"painel-abas\" role=\"tablist\" aria-label=\"Seções do painel\">\n        <button type=\"button\" role=\"tab\" class=\"painel-aba-btn ativa\" data-aba=\"anuncio\" id=\"abaAnuncio\" aria-selected=\"true\" aria-controls=\"painelAnuncio\">🛍️ Anúncio</button>\n        <button type=\"button\" role=\"tab\" class=\"painel-aba-btn\" data-aba=\"pedidos\" id=\"abaPedidos\" aria-selected=\"false\" aria-controls=\"painelPedidos\" tabindex=\"-1\">📦 Pedidos e vendas</button>\n        <button type=\"button\" role=\"tab\" class=\"painel-aba-btn\" data-aba=\"categorias\" id=\"abaCategorias\" aria-selected=\"false\" aria-controls=\"painelCategorias\" tabindex=\"-1\">🏷️ Categorias</button>\n        <button type=\"button\" role=\"tab\" class=\"painel-aba-btn\" data-aba=\"identidade\" id=\"abaIdentidade\" aria-selected=\"false\" aria-controls=\"painelIdentidade\" tabindex=\"-1\">⚙️ Identidade da loja</button>\n      </nav>\n      <button id=\"btnFazerLogout\" class=\"btn-link\" style=\"color: var(--danger);\">Sair</button>\n    </header>\n\n    <!-- ========== ANÚNCIO ========== -->\n    <section class=\"painel-secao ativa\" id=\"painelAnuncio\" role=\"tabpanel\" aria-labelledby=\"abaAnuncio\" data-aba=\"anuncio\">\n      <input type=\"hidden\" id=\"editDocId\" value=\"\">\n      <div class=\"anuncio-grid\">\n\n        <div class=\"anuncio-col anuncio-dados\">\n          <h4 class=\"anuncio-subtitulo\">Dados do anúncio <span id=\"painelEstado\" class=\"painel-estado escondido\"></span></h4>\n          <div class=\"campos-grid\">\n            <div class=\"form-group campo-largo\">\n              <label for=\"titulo\">Título do Carrossel:</label>\n              <input type=\"text\" id=\"titulo\" placeholder=\"Ex: Pacote de Artes Canecas Kombi Vintage\">\n            </div>\n\n            <div class=\"form-group\">\n              <label for=\"selectTipo\">Tipo:</label>\n              <select id=\"selectTipo\" class=\"select-custom\"><option value=\"\">Selecione...</option></select>\n            </div>\n            <div class=\"form-group\">\n              <label for=\"selectCategoria\">Categoria:</label>\n              <select id=\"selectCategoria\" class=\"select-custom\"><option value=\"\">Selecione...</option></select>\n            </div>\n            <div class=\"form-group\">\n              <label for=\"selectSubcategoria\">Subcategoria / Classe:</label>\n              <select id=\"selectSubcategoria\" class=\"select-custom\"><option value=\"\">Selecione...</option></select>\n            </div>\n            <div class=\"form-group campo-destaque\">\n              <label for=\"chkDestaque\">Vitrine:</label>\n              <label class=\"check-destaque\" for=\"chkDestaque\">\n                <input type=\"checkbox\" id=\"chkDestaque\"> ⭐ Destacar na loja\n              </label>\n            </div>\n\n            <div class=\"form-group campo-valor-group\">\n              <label for=\"preco\">Valor:</label>\n              <div class=\"campo-moeda-wrap\">\n                <span class=\"prefixo-moeda\">R$</span>\n                <input type=\"text\" id=\"preco\" inputmode=\"numeric\" placeholder=\"0,00\">\n              </div>\n            </div>\n            <div class=\"form-group campo-valor-group\">\n              <label for=\"precoPromo\">Valor promocional: <span class=\"dica-rotulo dica-destaque\" id=\"infoDesconto\"></span></label>\n              <div class=\"campo-moeda-wrap\">\n                <span class=\"prefixo-moeda\">R$</span>\n                <input type=\"text\" id=\"precoPromo\" inputmode=\"numeric\" placeholder=\"0,00\">\n              </div>\n            </div>\n\n            <div class=\"form-group campo-largo\">\n              <label for=\"promoAte\">Promoção vale até: <span class=\"dica-rotulo\">vazio = sem data de término</span></label>\n              <input type=\"datetime-local\" id=\"promoAte\" title=\"Depois da data, o preço volta ao normal sozinho\">\n            </div>\n\n            <div class=\"form-group campo-largo\">\n              <label for=\"linkCompra\">Link de Destino / Checkout:</label>\n              <input type=\"url\" id=\"linkCompra\" placeholder=\"https://seu-link.com\">\n            </div>\n\n            <div class=\"form-group campo-largo\">\n              <label for=\"tagsProduto\">Tags para a busca: <span class=\"dica-rotulo\">separe por espaço ou vírgula</span></label>\n              <input type=\"text\" id=\"tagsProduto\" placeholder=\"#kombi #verao #flores\" autocomplete=\"off\">\n            </div>\n\n          </div>\n        </div>\n\n        <div class=\"anuncio-col anuncio-texto\">\n          <h4 class=\"anuncio-subtitulo\">Descrição do anúncio</h4>\n      <div id=\"editorDescricaoWrap\" class=\"editor-wrap\">\n        <div class=\"editor-toolbar\" id=\"editorToolbar\" role=\"toolbar\" aria-label=\"Formatação do texto\">\n          <span class=\"editor-grupo\">\n            <button type=\"button\" tabindex=\"-1\" id=\"btnCriarTextoIA\" class=\"btn-ia\" title=\"Cria um texto de divulgação com IA a partir dos dados preenchidos\">✨ Criar com IA</button>\n          </span>\n          <span class=\"editor-grupo\">\n            <button type=\"button\" tabindex=\"-1\" data-cmd=\"bold\" title=\"Negrito\" aria-label=\"Negrito\"><b>B</b></button>\n            <button type=\"button\" tabindex=\"-1\" data-cmd=\"italic\" title=\"Itálico\" aria-label=\"Itálico\"><i>I</i></button>\n            <button type=\"button\" tabindex=\"-1\" data-cmd=\"underline\" title=\"Sublinhado\" aria-label=\"Sublinhado\"><u>U</u></button>\n          </span>\n          <span class=\"editor-grupo\">\n            <button type=\"button\" tabindex=\"-1\" data-cmd=\"titulo\" title=\"Transformar em título\" aria-label=\"Título\">Título</button>\n            <button type=\"button\" tabindex=\"-1\" data-cmd=\"insertUnorderedList\" title=\"Lista com marcadores\" aria-label=\"Lista com marcadores\">• Lista</button>\n            <button type=\"button\" tabindex=\"-1\" data-cmd=\"insertOrderedList\" title=\"Lista numerada\" aria-label=\"Lista numerada\">1. Lista</button>\n          </span>\n          <span class=\"editor-grupo\">\n            <button type=\"button\" tabindex=\"-1\" class=\"editor-cor\" data-cor=\"#BE3A78\" style=\"--cor:#BE3A78\" title=\"Rosa\" aria-label=\"Texto rosa\"></button>\n            <button type=\"button\" tabindex=\"-1\" class=\"editor-cor\" data-cor=\"#7E3C9F\" style=\"--cor:#7E3C9F\" title=\"Ameixa\" aria-label=\"Texto ameixa\"></button>\n            <button type=\"button\" tabindex=\"-1\" class=\"editor-cor\" data-cor=\"#0E8FA3\" style=\"--cor:#0E8FA3\" title=\"Azul\" aria-label=\"Texto azul\"></button>\n            <button type=\"button\" tabindex=\"-1\" class=\"editor-cor\" data-cor=\"#2E8B57\" style=\"--cor:#2E8B57\" title=\"Verde\" aria-label=\"Texto verde\"></button>\n            <button type=\"button\" tabindex=\"-1\" class=\"editor-cor\" data-cor=\"#D9731A\" style=\"--cor:#D9731A\" title=\"Laranja\" aria-label=\"Texto laranja\"></button>\n            <button type=\"button\" tabindex=\"-1\" class=\"editor-cor\" data-cor=\"#1B1230\" style=\"--cor:#1B1230\" title=\"Escuro\" aria-label=\"Texto escuro\"></button>\n          </span>\n          <span class=\"editor-grupo\">\n            <button type=\"button\" tabindex=\"-1\" id=\"btnInserirLink\" title=\"Link (selecione um trecho antes)\" aria-label=\"Link\">🔗 Link</button>\n            <button type=\"button\" tabindex=\"-1\" id=\"btnLimparFormatacao\" title=\"Remover toda a formatação do trecho\" aria-label=\"Limpar formatação\">Limpar</button>\n          </span>\n        </div>\n        <div id=\"editorDescricao\" class=\"editor-content\" contenteditable=\"true\" role=\"textbox\" aria-multiline=\"true\" data-placeholder=\"Digite aqui a descrição...\"></div>\n        <details id=\"detalhesIA\" class=\"detalhes-ia escondido\">\n          <summary>Ver detalhes do erro da IA</summary>\n          <pre id=\"logIA\"></pre>\n          <button type=\"button\" id=\"btnCopiarLogIA\" class=\"btn-link\">Copiar detalhes</button>\n        </details>\n        <button type=\"button\" id=\"btnDesfazerIA\" class=\"btn-link escondido\" style=\"align-self:flex-start;margin-top:8px\">↩ Voltar ao texto anterior</button>\n        <span class=\"hint editor-hint\">Selecione um trecho do texto e toque no botão da formatação. O botão ✨ cria um texto de divulgação com IA usando o título, o valor, as tags e o texto que você já escreveu.</span>\n      </div>\n        </div>\n\n        <div class=\"anuncio-col anuncio-imagens\">\n          <h4 class=\"anuncio-subtitulo\">Imagens do carrossel</h4>\n      <div class=\"grid-imagens-modal\" id=\"gridImagens\">\n        <div class=\"box-add-imagem\" id=\"btnAbrirWidgetCloudinary\">\n          <span style=\"font-size: 1.5rem; color: var(--text-muted);\">＋</span>\n          <p style=\"font-size: 0.75rem; color: var(--text-muted);\">Adicionar Imagens</p>\n        </div>\n      </div>\n      <span class=\"hint\">A primeira imagem é a capa. Arraste as imagens para mudar a ordem (no celular, segure a imagem um instante e arraste) ou toque em ⇧ para mandar uma para o início.</span>\n        </div>\n      </div>\n\n      <footer class=\"painel-acoes\">\n        <button id=\"btnCancelarEdit\" class=\"btn btn-secondary escondido\">Cancelar Edição</button>\n        <button id=\"btnSalvar\" class=\"btn btn-primary\">Publicar Carrossel</button>\n      </footer>\n    </section>\n\n    <!-- ========== PEDIDOS ========== -->\n    <section class=\"painel-secao\" id=\"painelPedidos\" role=\"tabpanel\" aria-labelledby=\"abaPedidos\" data-aba=\"pedidos\" hidden>\n      <div class=\"pedidos-topo\">\n        <span class=\"hint\" id=\"pedidosResumo\">Carregando os pedidos mais recentes…</span>\n        <button type=\"button\" id=\"btnPedidos\" class=\"btn btn-secondary\">Atualizar pedidos</button>\n      </div>\n      <div id=\"listaPedidos\" class=\"lista-pedidos\"></div>\n    </section>\n\n    <!-- ========== CATEGORIAS ========== -->\n    <section class=\"painel-secao\" id=\"painelCategorias\" role=\"tabpanel\" aria-labelledby=\"abaCategorias\" data-aba=\"categorias\" hidden>\n      <div class=\"anuncio-col categorias-form\">\n        <h4 class=\"anuncio-subtitulo\">Cadastrar Tipos / Categorias / Subcategorias</h4>\n        <div class=\"categorias-campos\">\n          <div class=\"form-group\">\n            <label for=\"novoTipo\">Tipo:</label>\n            <input type=\"text\" id=\"novoTipo\" placeholder=\"Ex: Canecas, Almofadas\">\n          </div>\n          <div class=\"form-group\">\n            <label for=\"novaCategoria\">Categoria:</label>\n            <input type=\"text\" id=\"novaCategoria\" placeholder=\"Ex: Datas Comemorativas\">\n          </div>\n          <div class=\"form-group\">\n            <label for=\"novaSubcategoria\">Subcategoria:</label>\n            <input type=\"text\" id=\"novaSubcategoria\" placeholder=\"Ex: Dia das Mães\">\n          </div>\n          <button id=\"btnCadastrarTaxonomia\" class=\"btn btn-secondary\">＋ Cadastrar Opção</button>\n        </div>\n      </div>\n      <div class=\"anuncio-col categorias-lista\">\n        <h4 class=\"anuncio-subtitulo\">Opções cadastradas</h4>\n        <div id=\"listaTaxonomias\" class=\"tags-taxonomia-container\"></div>\n      </div>\n    </section>\n\n    <!-- ========== IDENTIDADE ========== -->\n    <section class=\"painel-secao\" id=\"painelIdentidade\" role=\"tabpanel\" aria-labelledby=\"abaIdentidade\" data-aba=\"identidade\" hidden>\n      <div class=\"identidade-grid\">\n\n        <!-- ===== MARCA ===== -->\n        <div class=\"anuncio-col id-marca\">\n          <h4 class=\"anuncio-subtitulo\">Marca da loja</h4>\n          <div class=\"form-group\">\n            <label for=\"cfgNome\">Nome da loja <span class=\"dica-rotulo\">aparece no topo do site</span></label>\n            <input type=\"text\" id=\"cfgNome\" maxlength=\"60\" placeholder=\"Ex: Almatiê Art\" autocomplete=\"off\">\n          </div>\n          <div class=\"form-group\">\n            <label for=\"cfgSlogan\">Texto abaixo do nome <span class=\"dica-rotulo\">opcional</span></label>\n            <input type=\"text\" id=\"cfgSlogan\" maxlength=\"120\" placeholder=\"Ex: Artes digitais para sublimação\" autocomplete=\"off\">\n          </div>\n          <div class=\"marca-imagens\">\n            <div class=\"upload-preview-container\">\n              <div class=\"preview-box\">\n                <img id=\"previewLogo\" src=\"\" alt=\"Preview Logo\" class=\"escondido\">\n                <span id=\"textNoLogo\" class=\"hint\">Sem logo</span>\n              </div>\n              <button type=\"button\" id=\"btnUploadLogo\" class=\"btn btn-secondary\">📁 Logo</button>\n            </div>\n            <div class=\"upload-preview-container\">\n              <div class=\"preview-box preview-favicon\">\n                <img id=\"previewFavicon\" src=\"\" alt=\"Preview Favicon\" class=\"escondido\">\n                <span id=\"textNoFavicon\" class=\"hint\">Sem favicon</span>\n              </div>\n              <button type=\"button\" id=\"btnUploadFavicon\" class=\"btn btn-secondary\">📁 Favicon</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- ===== CORES ===== -->\n        <div class=\"anuncio-col id-cores\">\n          <h4 class=\"anuncio-subtitulo\">Cores do site <button type=\"button\" id=\"btnCoresPadrao\" class=\"btn-link\">Restaurar padrão</button></h4>\n          <div class=\"cor-linha\">\n            <label for=\"cfgCorPrimaria\">Cor principal <span class=\"dica-rotulo\">botões, preços e destaques</span></label>\n            <input type=\"color\" id=\"cfgCorPrimaria\" aria-label=\"Escolher a cor principal\">\n            <input type=\"text\" id=\"cfgCorPrimariaHex\" maxlength=\"7\" spellcheck=\"false\" aria-label=\"Código da cor principal\">\n          </div>\n          <div class=\"cor-linha\">\n            <label for=\"cfgCorSecundaria\">Cor secundária <span class=\"dica-rotulo\">fim do degradê</span></label>\n            <input type=\"color\" id=\"cfgCorSecundaria\" aria-label=\"Escolher a cor secundária\">\n            <input type=\"text\" id=\"cfgCorSecundariaHex\" maxlength=\"7\" spellcheck=\"false\" aria-label=\"Código da cor secundária\">\n          </div>\n          <div class=\"cor-linha\">\n            <label for=\"cfgCorFundo\">Fundo da página <span class=\"dica-rotulo\">cor atrás dos anúncios</span></label>\n            <input type=\"color\" id=\"cfgCorFundo\" aria-label=\"Escolher a cor de fundo\">\n            <input type=\"text\" id=\"cfgCorFundoHex\" maxlength=\"7\" spellcheck=\"false\" aria-label=\"Código da cor de fundo\">\n          </div>\n          <div class=\"cor-linha\">\n            <label for=\"cfgCorTexto\">Cor dos textos <span class=\"dica-rotulo\">títulos e descrições</span></label>\n            <input type=\"color\" id=\"cfgCorTexto\" aria-label=\"Escolher a cor dos textos\">\n            <input type=\"text\" id=\"cfgCorTextoHex\" maxlength=\"7\" spellcheck=\"false\" aria-label=\"Código da cor dos textos\">\n          </div>\n          <div id=\"cfgContraste\" class=\"cor-aviso\" aria-live=\"polite\"></div>\n          <span class=\"hint\">As mudanças aparecem na hora, neste computador. Só valem para todo mundo depois de salvar. Os cartões dos anúncios continuam brancos.</span>\n        </div>\n\n        <!-- ===== FAIXA DE DESTAQUE ===== -->\n        <div class=\"anuncio-col id-faixa\">\n          <h4 class=\"anuncio-subtitulo\">Faixa de destaque do topo <button type=\"button\" id=\"btnFaixaPadrao\" class=\"btn-link\">Restaurar padrão</button></h4>\n          <label class=\"check-destaque\" for=\"cfgFaixaVisivel\">\n            <input type=\"checkbox\" id=\"cfgFaixaVisivel\"> Mostrar a faixa na loja\n          </label>\n\n          <section class=\"hero-loja sf-hero cfg-previa\" id=\"cfgPrevia\" aria-label=\"Prévia da faixa\">\n            <div class=\"hero-texto\"><h2></h2><p></p></div>\n            <nav class=\"hero-atalhos\" aria-label=\"Botões da faixa\"></nav>\n          </section>\n\n          <div class=\"form-group\">\n            <label for=\"cfgFaixaTitulo\">Título</label>\n            <input type=\"text\" id=\"cfgFaixaTitulo\" maxlength=\"120\" autocomplete=\"off\">\n          </div>\n          <div class=\"form-group\">\n            <label for=\"cfgFaixaTexto\">Texto <span class=\"dica-rotulo\">opcional</span></label>\n            <textarea id=\"cfgFaixaTexto\" rows=\"2\" maxlength=\"300\"></textarea>\n          </div>\n\n          <div class=\"faixa-cores\">\n            <label class=\"check-destaque\" for=\"cfgFaixaCorPropria\">\n              <input type=\"checkbox\" id=\"cfgFaixaCorPropria\"> Usar cores próprias na faixa\n            </label>\n            <div class=\"faixa-cores-campos\">\n              <label class=\"cor-mini\" for=\"cfgFaixaCorInicio\">Início <input type=\"color\" id=\"cfgFaixaCorInicio\"></label>\n              <label class=\"cor-mini\" for=\"cfgFaixaCorFim\">Fim <input type=\"color\" id=\"cfgFaixaCorFim\"></label>\n              <label class=\"cor-mini\" for=\"cfgFaixaCorTexto\">Texto <input type=\"color\" id=\"cfgFaixaCorTexto\"></label>\n            </div>\n          </div>\n\n          <div class=\"botoes-cabecalho\">\n            <strong>Botões da faixa</strong>\n            <span class=\"hint\">ícone, texto pequeno (opcional) e link</span>\n          </div>\n          <div id=\"cfgBotoes\" class=\"botoes-lista\"></div>\n          <button type=\"button\" id=\"cfgAddBotao\" class=\"btn btn-secondary\">＋ Adicionar botão</button>\n\n          <div id=\"cfgSeletorIcone\" class=\"seletor-icone escondido\" role=\"dialog\" aria-label=\"Escolher o ícone do botão\">\n            <div class=\"seletor-grade\" id=\"cfgIconeGrade\"></div>\n            <div class=\"seletor-extra\">\n              <label class=\"seletor-emoji\" for=\"cfgEmoji\">Ou use um emoji\n                <input type=\"text\" id=\"cfgEmoji\" maxlength=\"4\" placeholder=\"😀\" autocomplete=\"off\">\n              </label>\n              <button type=\"button\" id=\"cfgIconeImagem\" class=\"btn btn-secondary\">🖼️ Enviar imagem</button>\n              <button type=\"button\" id=\"cfgIconeFechar\" class=\"btn-link\">Fechar</button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <footer class=\"painel-acoes\">\n        <span id=\"cfgAviso\" class=\"hint escondido\">Alterações ainda não salvas</span>\n        <button type=\"button\" id=\"btnDescartarConfig\" class=\"btn btn-secondary\">Descartar alterações</button>\n        <button id=\"btnSalvarConfig\" class=\"btn btn-primary\">Salvar identidade visual</button>\n      </footer>\n    </section>\n  </div>\n",
-  js: "// Painel de gestão do Almatiê — este código só é entregue ao administrador logado.\nexport async function iniciar(api) {\n  const { db, auth, esc, mostrarToast, sanitizarDescricao, precoParaNumero, formatarFimPromo, htmlParaTexto, normalizarTexto,\n          carregarProdutos, ADMIN_WORKER } = api;\n  const { collection, addDoc, getDocs, doc, updateDoc, setDoc, getDoc, deleteDoc } = api.firestore;\n\n  // O envio de imagens usa o widget do Cloudinary: só é baixado quando o admin abre o painel\n  await new Promise((ok, falha) => {\n    if (window.cloudinary) return ok();\n    const s = document.createElement('script');\n    s.src = 'https://upload-widget.cloudinary.com/global/all.js';\n    s.onload = ok;\n    s.onerror = () => falha(new Error('Não foi possível carregar o envio de imagens.'));\n    document.head.appendChild(s);\n  });\n\n  const CLOUD_NAME = \"zxi2bufg\"; \n\n  const UPLOAD_PRESET = \"almatie\";\n\n  // Workers de IA para criar o texto de divulgação. Tenta na ordem; se um não responder, passa para o próximo.\n  // Os 3 últimos (astro-gns-proxy, shiny-sky-21dd, astro2) vêm por último: só são usados se todos os anteriores falharem.\n  const WORKERS_IA = [\n    \"https://certificados-groq-proxy.genesisgns.workers.dev/\",\n    \"https://gns91-groq-proxy.genesisgns.workers.dev/\",\n    \"https://forzion-gpt-proxy.genesisgns.workers.dev/\",\n    \"https://mamoot-gpt-proxy.genesisgns.workers.dev/\",\n    \"https://interno.genesisgns.workers.dev/\",\n    // ---- instáveis: sempre por último ----\n    \"https://astro-gns-proxy.genesisgns.workers.dev/\",\n    \"https://shiny-sky-21dd.genesisgns.workers.dev/\",\n    \"https://astro2.genesisgns.workers.dev/\"\n  ];\n\n  const IA_MODELO = \"llama-3.3-70b-versatile\";   // usado pelos workers do tipo Groq; os demais ignoram\n\n  async function chamarWorkerAdmin(rota, corpo) {\n    if (!auth.currentUser) throw new Error(\"Faça login como admin.\");\n    const token = await auth.currentUser.getIdToken();\n    const r = await fetch(`${ADMIN_WORKER}${rota}`, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\", \"Authorization\": `Bearer ${token}` },\n      body: JSON.stringify(corpo)\n    });\n    const dados = await r.json().catch(() => ({}));\n    if (!r.ok) throw new Error(dados.error || \"Falha ao falar com o servidor.\");\n    return dados;\n  }\n\n  let taxonomiasMemoria = [];\n\n  let listaImagensAtuais = [];\n\n  let logoUrlTemp = \"\";\n\n  let faviconUrlTemp = \"\";\n\n  // =========================================================\n  // EDITOR DE TEXTO SIMPLES (descrição do produto)\n  // =========================================================\n  let selecaoEditor = null;\n\n  const obterEditor = () => document.getElementById('editorDescricao');\n\n  // Guarda onde o cursor/seleção está, para os botões da barra agirem no trecho certo\n  function salvarSelecaoEditor() {\n    const sel = window.getSelection();\n    if (sel && sel.rangeCount && obterEditor().contains(sel.anchorNode)) {\n      selecaoEditor = sel.getRangeAt(0).cloneRange();\n    }\n  }\n\n  function restaurarSelecaoEditor() {\n    obterEditor().focus({ preventScroll: true });\n    if (selecaoEditor) {\n      const sel = window.getSelection();\n      sel.removeAllRanges();\n      sel.addRange(selecaoEditor);\n    }\n  }\n\n  function executarComandoEditor(comando, valor = null) {\n    restaurarSelecaoEditor();\n    try { document.execCommand('styleWithCSS', false, comando === 'foreColor'); } catch (e) { /* ignora */ }\n    document.execCommand(comando, false, valor);\n    salvarSelecaoEditor();\n    atualizarEstadoBotoesEditor();\n    atualizarPlaceholderEditor();\n  }\n\n  const blocoAtualEditor = () => String(document.queryCommandValue('formatBlock') || '').toLowerCase().replace(/[<>]/g, '');\n\n  function alternarTituloEditor() {\n    restaurarSelecaoEditor();\n    const sel = window.getSelection();\n    const no = sel && sel.anchorNode && (sel.anchorNode.nodeType === 1 ? sel.anchorNode : sel.anchorNode.parentElement);\n    const titulo = no && no.closest('h3');\n    if (titulo && obterEditor().contains(titulo)) {\n      // volta a ser texto comum (o navegador aninha tags quando se faz isso por comando)\n      const comum = document.createElement('div');\n      while (titulo.firstChild) comum.appendChild(titulo.firstChild);\n      titulo.replaceWith(comum);\n    } else {\n      document.execCommand('formatBlock', false, 'h3');\n    }\n    salvarSelecaoEditor();\n    atualizarEstadoBotoesEditor();\n  }\n\n  function atualizarEstadoBotoesEditor() {\n    const sel = window.getSelection();\n    if (!sel || !sel.rangeCount || !obterEditor().contains(sel.anchorNode)) return;\n    document.querySelectorAll('#editorToolbar [data-cmd]').forEach((btn) => {\n      try {\n        const cmd = btn.dataset.cmd;\n        btn.classList.toggle('ativo', cmd === 'titulo' ? blocoAtualEditor() === 'h3' : document.queryCommandState(cmd));\n      } catch (e) { /* comando não suportado neste navegador */ }\n    });\n    const no = sel.anchorNode.nodeType === 1 ? sel.anchorNode : sel.anchorNode.parentElement;\n    document.getElementById('btnInserirLink').classList.toggle('ativo', !!(no && no.closest('a')));\n  }\n\n  function atualizarPlaceholderEditor() {\n    const editor = obterEditor();\n    editor.classList.toggle('vazio', editor.textContent.trim().length === 0 && !editor.querySelector('li'));\n  }\n\n  // Um só botão: coloca o link no trecho selecionado ou, se já houver link ali, tira\n  function inserirLinkEditor() {\n    restaurarSelecaoEditor();\n    const sel = window.getSelection();\n    const no = sel && sel.anchorNode && (sel.anchorNode.nodeType === 1 ? sel.anchorNode : sel.anchorNode.parentElement);\n    if (no && no.closest('a')) {\n      document.execCommand('unlink', false, null);\n      salvarSelecaoEditor();\n      atualizarEstadoBotoesEditor();\n      return;\n    }\n    if (!sel || sel.isCollapsed) {\n      mostrarToast('Selecione um trecho do texto para transformar em link.', 'erro');\n      return;\n    }\n    let url = (prompt('Cole o endereço do link:', 'https://') || '').trim();\n    if (!url) return;\n    if (!/^https?:\\/\\//i.test(url)) url = 'https://' + url;\n    try { new URL(url); } catch (e) { mostrarToast('Esse endereço de link não parece válido.', 'erro'); return; }\n    restaurarSelecaoEditor();\n    document.execCommand('createLink', false, url);\n    salvarSelecaoEditor();\n    atualizarEstadoBotoesEditor();\n  }\n\n  function limparFormatacaoEditor() {\n    restaurarSelecaoEditor();\n    document.execCommand('removeFormat', false, null);\n    document.execCommand('unlink', false, null);\n    document.execCommand('formatBlock', false, 'p');\n    salvarSelecaoEditor();\n    atualizarEstadoBotoesEditor();\n  }\n\n  function iniciarEditorTexto() {\n    const editor = obterEditor();\n    const barra = document.getElementById('editorToolbar');\n\n    // Tocar nos botões não tira o foco nem a seleção do texto (era isso que \"bugava\")\n    barra.addEventListener('mousedown', (e) => { if (e.target.closest('button')) e.preventDefault(); });\n    barra.addEventListener('click', (e) => {\n      const btn = e.target.closest('button');\n      if (!btn) return;\n      if (btn.dataset.cor) { executarComandoEditor('foreColor', btn.dataset.cor); return; }\n      if (btn.id === 'btnInserirLink') { inserirLinkEditor(); return; }\n      if (btn.id === 'btnLimparFormatacao') { limparFormatacaoEditor(); return; }\n      if (btn.id === 'btnCriarTextoIA') { criarTextoComIA(); return; }\n      if (btn.dataset.cmd === 'titulo') { alternarTituloEditor(); return; }\n      if (btn.dataset.cmd) executarComandoEditor(btn.dataset.cmd);\n    });\n\n    // Funciona também com a seleção feita no toque (celular)\n    document.addEventListener('selectionchange', () => { salvarSelecaoEditor(); atualizarEstadoBotoesEditor(); });\n\n    editor.addEventListener('input', atualizarPlaceholderEditor);\n    // Colar sempre como texto simples: sem fontes e cores bagunçadas de outros sites\n    editor.addEventListener('paste', (e) => {\n      e.preventDefault();\n      const texto = (e.clipboardData || window.clipboardData).getData('text/plain');\n      document.execCommand('insertText', false, texto);\n    });\n    editor.addEventListener('drop', (e) => e.preventDefault());\n    document.getElementById('btnDesfazerIA').addEventListener('click', voltarTextoAntesIA);\n    document.getElementById('btnCopiarLogIA').addEventListener('click', async () => {\n      const texto = document.getElementById('logIA').textContent;\n      try { await navigator.clipboard.writeText(texto); mostrarToast('Detalhes copiados.', 'sucesso'); }\n      catch (e) { mostrarToast('Selecione o texto e copie manualmente.', 'erro'); }\n    });\n    atualizarPlaceholderEditor();\n  }\n\n  function extrairTags(texto) {\n    const vistos = new Set();\n    const lista = [];\n    String(texto || '').split(/[\\s,;]+/).forEach((t) => {\n      t = t.replace(/^#+/, '').trim().slice(0, 30);\n      const chave = normalizarTexto(t);\n      if (t && !vistos.has(chave)) { vistos.add(chave); lista.push(t); }\n    });\n    return lista.slice(0, 25);\n  }\n\n  const paraCampoDataHora = (ms) => new Date(ms - new Date(ms).getTimezoneOffset() * 60000).toISOString().slice(0, 16);\n\n  function atualizarInfoDesconto() {\n    const normal = precoParaNumero(document.getElementById('preco').value);\n    const promo = precoParaNumero(document.getElementById('precoPromo').value);\n    const info = document.getElementById('infoDesconto');\n    info.textContent = (promo > 0 && normal > 0 && promo < normal) ? `−${Math.round((1 - promo / normal) * 100)}%` :\n      (promo > 0 && normal > 0 ? 'deve ser menor que o valor' : '');\n  }\n\n  // =========================================================\n  // TEXTO DE DIVULGAÇÃO COM IA\n  // =========================================================\n  let textoAntesIA = null;\n\n  const AVISO_PRODUTO_DIGITAL = '<p><i>⚠️ Aviso: este é um produto digital. O link para download será disponibilizado após a confirmação do pagamento. Nenhum produto físico será enviado — caso você espere receber as artes impressas, este produto não é o ideal.</i></p>';\n\n  const MARCA_TAGS = '[[TAGS]]';\n\n  function montarMensagensIA(d) {\n    const sistema = `Você é redator publicitário de e-commerce brasileiro e escreve textos curtos de divulgação para a loja \"Almatiê Art\", que vende pacotes de artes digitais prontas para quem trabalha com produtos personalizados (sublimação, DTF e outras personalizações). O objetivo é poupar o trabalho do cliente de criar artes do zero. Os pacotes são sempre bem organizados.\n\nPARTE 1 - DESCRIÇÃO. Escreva em HTML simples, usando SOMENTE as tags: <h3>, <p>, <b>, <ul>, <li>, <br> e <span style=\"color:#BE3A78\"> (rosa) ou <span style=\"color:#7E3C9F\"> (ameixa) para destacar poucas palavras. Estrutura:\n1. <h3> com um título de chamada chamativo ligado ao TEMA da arte (use a categoria/classe e o título do carrossel), com 1 emoji.\n2. <p> com 1 ou 2 frases em tom publicitário: para quem o pacote serve e a vantagem de já receber as artes prontas.\n3. <ul> de 1 a 5 <li> curtos, cada um começando com um emoji, descrevendo o que a pessoa vai receber. Cada <li> deve corresponder a algo que está ESCRITO no texto atual ou nos campos (por exemplo: a quantidade de artes e o que mais o texto atual citar). Se só a quantidade de artes foi informada, a lista terá apenas esse item (ou 2, juntando com o tema/uso).\n4. <p> final com uma chamada para ação curta e 1 emoji.\nRegras: português do Brasil; tom publicitário caloroso e profissional, sem exageros e sem escrever em MAIÚSCULAS; entre 70 e 130 palavras; no máximo 8 emojis. REGRA MAIS IMPORTANTE: use APENAS informações que estejam escritas nos campos ou no texto atual. Nem todo pacote tem mockups, arquivos editáveis, bônus ou formatos especiais: só cite mockups, editáveis, bônus, formatos de arquivo, resolução, medidas ou prazos se isso aparecer explicitamente no texto atual. Na dúvida, NÃO cite. Nunca complete a lista com itens genéricos para ficar mais cheia; uma lista curta e verdadeira é o correto. Se (e somente se) existir o campo \"Pacote Premium: sim\", deixe claro que é uma coleção Premium: artes com acabamento mais cuidadoso, montagem caprichada e qualidade superior, produzidas com mais tempo e atenção (sem citar preço mais alto). Se houver promoção, informe o valor com clareza e a data de término, se existir. NÃO escreva nenhum aviso sobre produto digital, download, pagamento ou entrega física: esse aviso é adicionado automaticamente depois, e você deve ignorar avisos desse tipo que existirem no texto atual.\n\nPARTE 2 - TAGS. Depois do HTML, escreva em uma nova linha exatamente ${MARCA_TAGS} e, logo em seguida, de 6 a 10 tags de busca no formato #tag separadas por espaço, em minúsculas, sem acentos e sem espaços dentro de cada tag. As tags servem de FILTRO de busca, então devem ser ESPECÍFICAS deste pacote: o tema (ex.: #signos), os elementos ou subtemas dele (ex.: #zodiaco #astrologia #horoscopo), o tipo de produto (ex.: #caneca), a categoria/data (ex.: #diadasmaes) e variações que o cliente digitaria para esse tema. Use as palavras do título, tipo, categoria e subcategoria como ponto de partida.\nPROIBIDO nas tags: termos genéricos que servem para qualquer pacote (#artesprontas #artepersonalizada #arte #artes #editavel #mockup #mockups #pacotedeartes #personalizado #sublimacao #dtf #digital #premium). Só use uma técnica (sublimação, DTF) ou \"premium\" se estiver escrita nos campos ou no texto atual; nunca invente uma técnica.\n\nResponda apenas com o HTML, a linha ${MARCA_TAGS} e as tags, sem explicações e sem blocos de código.`;\n\n    const linhas = [`- Título do carrossel: ${d.titulo}`];\n    if (d.tipo) linhas.push(`- Tipo: ${d.tipo}`);\n    if (d.categoria) linhas.push(`- Categoria: ${d.categoria}`);\n    if (d.subcategoria) linhas.push(`- Subcategoria / Classe: ${d.subcategoria}`);\n    if (d.premium) linhas.push('- Pacote Premium: sim');\n    if (d.preco) linhas.push(`- Valor: R$ ${d.preco}`);\n    if (d.precoPromo) linhas.push(`- Promoção: de R$ ${d.preco} por R$ ${d.precoPromo}${d.promoAte ? ` (até ${d.promoAte})` : ''}`);\n    if (d.tags.length) linhas.push(`- Tags já preenchidas: ${d.tags.join(', ')}`);\n\n    const aspas = '\"\"\"';\n    const usuario = `Dados do produto:\\n${linhas.join('\\n')}\\n\\n` +\n      (d.textoAtual ? `Texto atual da Descrição do Produto (use como base: aproveite quantidades, adicionais, mockups, editáveis e demais informações, melhorando e padronizando):\\n${aspas}\\n${d.textoAtual}\\n${aspas}\\n\\n` : '') +\n      'Crie a descrição de venda padronizada e as tags.';\n    return [{ role: 'system', content: sistema }, { role: 'user', content: usuario }];\n  }\n\n  // Separa a resposta da IA em descrição (HTML) e tags\n  const TAGS_GENERICAS = new Set(['artesprontas','arteprontas','artepersonalizada','artespersonalizadas','arte','artes','editavel','editaveis','mockup','mockups','pacotedeartes','pacotedearte','personalizado','personalizados','digital','pacote','pacotes','vetor','png']);\n\n  function filtrarTagsIA(tags, dados) {\n    const base = normalizarTexto([dados.titulo, dados.tipo, dados.categoria, dados.subcategoria, dados.textoAtual, dados.tags.join(' ')].join(' ')).replace(/[^a-z0-9]/g, '');\n    return tags.filter((t) => {\n      const k = normalizarTexto(t).replace(/[^a-z0-9]/g, '');\n      if (!k || TAGS_GENERICAS.has(k)) return false;\n      if (/premium/.test(k) && !dados.premium) return false;\n      if (/dtf/.test(k) && !/dtf/.test(base)) return false;\n      if (/sublim/.test(k) && !/sublim/.test(base)) return false;\n      return true;\n    });\n  }\n\n  function separarDescricaoETags(bruto) {\n    const t = String(bruto || '');\n    const pos = t.indexOf(MARCA_TAGS);\n    if (pos === -1) return { descricao: t, tags: [] };\n    const tags = extrairTags(t.slice(pos + MARCA_TAGS.length).replace(/<[^>]*>/g, ' '));\n    return { descricao: t.slice(0, pos), tags };\n  }\n\n  function primeiroTextoLongo(no, profundidade = 0) {\n    if (typeof no === 'string') return no.trim().length >= 40 ? no : '';\n    if (!no || typeof no !== 'object' || profundidade > 5) return '';\n    for (const [chave, valor] of Object.entries(no)) {\n      if (/^(model|id|object|system_fingerprint|usage|error|created)$/i.test(chave)) continue;\n      const achado = primeiroTextoLongo(valor, profundidade + 1);\n      if (achado) return achado;\n    }\n    return '';\n  }\n\n  function extrairTextoIA(r) {\n    if (typeof r === 'string') return r;\n    const c = r && (\n      r.choices?.[0]?.message?.content ?? r.choices?.[0]?.text ?? r.content?.[0]?.text ?? r.content ??\n      r.candidates?.[0]?.content?.parts?.[0]?.text ?? r.message?.content ?? r.message ??\n      r.text ?? r.response ?? r.result ?? r.output ?? r.reply ?? r.answer ?? r.data);\n    return typeof c === 'string' && c.trim() ? c : primeiroTextoLongo(r);   // último recurso: o primeiro texto longo da resposta\n  }\n\n  function textoIAparaHtml(bruto) {\n    let t = String(bruto || '').trim().replace(/^```(?:html)?\\s*/i, '').replace(/\\s*```$/, '').trim();\n    const negrito = (s) => esc(s).replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>');\n    if (/<(h3|h4|p|ul|ol|li|div|br)\\b/i.test(t)) {\n      t = t.replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>');            // veio HTML: só garante o negrito\n    } else {                                                    // veio texto puro: vira parágrafos, título e lista\n      let saida = '', emLista = false;\n      t.split(/\\n+/).map((l) => l.trim()).filter(Boolean).forEach((l) => {\n        const item = l.match(/^[-•*]\\s+(.*)$/);\n        if (item) {\n          if (!emLista) { saida += '<ul>'; emLista = true; }\n          saida += `<li>${negrito(item[1])}</li>`;\n          return;\n        }\n        if (emLista) { saida += '</ul>'; emLista = false; }\n        const titulo = l.match(/^#{1,4}\\s+(.*)$/);\n        saida += titulo ? `<h3>${negrito(titulo[1])}</h3>` : `<p>${negrito(l)}</p>`;\n      });\n      if (emLista) saida += '</ul>';\n      t = saida;\n    }\n    return sanitizarDescricao(t);\n  }\n\n  // Formatos de pedido que os workers costumam aceitar. O site tenta um por vez e lembra qual funcionou em cada worker.\n  const IA_FORMATOS = [\n    { nome: 'chat com modelo', corpo: (m) => ({ model: IA_MODELO, messages: m, temperature: 0.4, max_tokens: 1000 }) },\n    { nome: 'chat sem modelo', corpo: (m) => ({ messages: m, temperature: 0.4, max_tokens: 1000 }) },\n    { nome: 'prompt único', corpo: (m, p) => ({ prompt: p }) },\n    { nome: 'sistema + prompt', corpo: (m) => ({ system: m[0].content, prompt: m[1].content }) }\n  ];\n\n  function lerFormatosIA() {\n    try { return JSON.parse(localStorage.getItem('almatie_ia_formatos_v2') || '{}'); } catch (e) { return {}; }\n  }\n\n  function guardarFormatoIA(urlWorker, indiceFormato) {\n    try { const f = lerFormatosIA(); f[urlWorker] = indiceFormato; localStorage.setItem('almatie_ia_formatos_v2', JSON.stringify(f)); } catch (e) { /* ignora */ }\n  }\n\n  async function chamarWorkerIA(url, corpo) {\n    const controle = new AbortController();\n    const limite = setTimeout(() => controle.abort(), 20000);\n    try {\n      const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(corpo), signal: controle.signal });\n      return { ok: r.ok, status: r.status, bruto: await r.text() };\n    } finally {\n      clearTimeout(limite);\n    }\n  }\n\n  async function gerarTextoPromocional(dados, aoTentar) {\n    const mensagens = montarMensagensIA(dados);\n    const prompt = mensagens.map((m) => m.content).join('\\n\\n');\n    const lembrados = lerFormatosIA();\n    const log = [`Site: ${location.origin}  ·  modelo enviado: ${IA_MODELO}`];\n\n    for (let i = 0; i < WORKERS_IA.length; i++) {\n      if (aoTentar) aoTentar(i + 1, WORKERS_IA.length);\n      const nome = new URL(WORKERS_IA[i]).hostname.split('.')[0];\n      const ordem = IA_FORMATOS.map((f, k) => k);\n      const lembrado = lembrados[WORKERS_IA[i]];\n      if (lembrado != null) ordem.sort((a, b) => (a === lembrado ? -1 : b === lembrado ? 1 : 0));\n\n      for (const k of ordem) {\n        const formato = IA_FORMATOS[k];\n        const prefixo = `${i + 1}) ${nome} · formato \"${formato.nome}\" · `;\n        let resp;\n        try {\n          resp = await chamarWorkerIA(WORKERS_IA[i], formato.corpo(mensagens, prompt));\n        } catch (e) {\n          log.push(prefixo + (e.name === 'AbortError' ? 'sem resposta em 20 segundos' : 'sem resposta: bloqueado pelo navegador (CORS) ou sem conexão'));\n          break;                                              // outro formato não resolveria: próximo worker\n        }\n        const trecho = resp.bruto.replace(/\\s+/g, ' ').slice(0, 220);\n        if (!resp.ok) {\n          log.push(prefixo + `HTTP ${resp.status} · ${trecho}`);\n          if (resp.status >= 500 || resp.status === 429) break;\n          continue;                                           // erro 4xx: tenta outro formato no mesmo worker\n        }\n        let resposta;\n        try { resposta = JSON.parse(resp.bruto); } catch (e) { resposta = resp.bruto; }\n        if (resposta && typeof resposta === 'object' && resposta.error) {\n          log.push(prefixo + `erro na resposta · ${trecho}`);\n          continue;\n        }\n        const partes = separarDescricaoETags(extrairTextoIA(resposta));\n        const html = textoIAparaHtml(partes.descricao);\n        if (htmlParaTexto(html).trim().length < 40) {\n          log.push(prefixo + `respondeu, mas sem texto aproveitável · ${trecho}`);\n          break;\n        }\n        guardarFormatoIA(WORKERS_IA[i], k);\n        return { html: html + AVISO_PRODUTO_DIGITAL, tags: partes.tags };\n      }\n    }\n    const erro = new Error('Nenhuma IA respondeu. Veja os detalhes abaixo do editor.');\n    erro.detalhes = log.join('\\n');\n    throw erro;\n  }\n\n  function mostrarDetalhesIA(texto) {\n    const caixa = document.getElementById('detalhesIA');\n    document.getElementById('logIA').textContent = texto || '';\n    caixa.classList.toggle('escondido', !texto);\n    caixa.open = !!texto;\n  }\n\n  async function criarTextoComIA() {\n    const titulo = document.getElementById('titulo').value.trim();\n    if (!titulo) { mostrarToast('Preencha o título antes de criar o texto com IA.', 'erro'); return; }\n\n    const promoAte = document.getElementById('promoAte').value;\n    const dados = {\n      titulo,\n      tipo: document.getElementById('selectTipo').value,\n      categoria: document.getElementById('selectCategoria').value,\n      subcategoria: document.getElementById('selectSubcategoria').value,\n      preco: document.getElementById('preco').value.trim(),\n      precoPromo: document.getElementById('precoPromo').value.trim(),\n      promoAte: promoAte ? formatarFimPromo(new Date(promoAte).getTime()) : '',\n      tags: extrairTags(document.getElementById('tagsProduto').value),\n      textoAtual: (obterEditor().innerText || '').trim().slice(0, 1500)\n    };\n    dados.premium = /premium/i.test([dados.titulo, dados.tipo, dados.categoria, dados.subcategoria, dados.textoAtual, dados.tags.join(' ')].join(' '));\n\n    const btn = document.getElementById('btnCriarTextoIA');\n    btn.disabled = true;\n    mostrarDetalhesIA('');\n    try {\n      const resultado = await gerarTextoPromocional(dados, (n, total) => { btn.textContent = n === 1 ? '✨ Criando…' : `✨ Tentando outra IA (${n}/${total})…`; });\n      textoAntesIA = obterEditor().innerHTML;\n      obterEditor().innerHTML = resultado.html;\n      if (filtrarTagsIA(resultado.tags, dados).length) {\n        const campoTags = document.getElementById('tagsProduto');\n        const todas = extrairTags([...dados.tags, ...filtrarTagsIA(resultado.tags, dados)].join(' ')).slice(0, 15);\n        campoTags.value = todas.map((t) => '#' + t).join(' ');\n      }\n      atualizarPlaceholderEditor();\n      document.getElementById('btnDesfazerIA').classList.remove('escondido');\n      mostrarToast('Texto criado! Revise e ajuste se quiser.', 'sucesso');\n    } catch (e) {\n      mostrarDetalhesIA(e.detalhes || '');\n      mostrarToast(e.message || 'Não foi possível criar o texto.', 'erro');\n    } finally {\n      btn.disabled = false;\n      btn.textContent = '✨ Criar com IA';\n    }\n  }\n\n  function voltarTextoAntesIA() {\n    if (textoAntesIA === null) return;\n    obterEditor().innerHTML = textoAntesIA;\n    textoAntesIA = null;\n    atualizarPlaceholderEditor();\n    document.getElementById('btnDesfazerIA').classList.add('escondido');\n  }\n\n  // MÁSCARA DE MOEDA (R$ 0,00)\n  function aplicarMascaraMoeda(input) {\n    input.addEventListener('input', () => {\n      let digitos = input.value.replace(/\\D/g, '');\n      if (!digitos) {\n        input.value = '';\n        return;\n      }\n      while (digitos.length < 3) digitos = '0' + digitos;\n      const centavos = digitos.slice(-2);\n      let inteiro = digitos.slice(0, -2).replace(/^0+(?=\\d)/, '');\n      inteiro = inteiro.replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\n      input.value = `${inteiro},${centavos}`;\n    });\n  }\n\n  // CLOUDINARY LOGO & FAVICON\n  const widgetLogo = cloudinary.createUploadWidget({ cloudName: CLOUD_NAME, uploadPreset: UPLOAD_PRESET, multiple: false }, (err, res) => {\n    if (!err && res && res.event === \"success\") {\n      logoUrlTemp = res.info.secure_url;\n      atualizarPreviewElemento('previewLogo', 'textNoLogo', logoUrlTemp);\n    }\n  });\n\n  const widgetFavicon = cloudinary.createUploadWidget({ cloudName: CLOUD_NAME, uploadPreset: UPLOAD_PRESET, multiple: false }, (err, res) => {\n    if (!err && res && res.event === \"success\") {\n      faviconUrlTemp = res.info.secure_url;\n      atualizarPreviewElemento('previewFavicon', 'textNoFavicon', faviconUrlTemp);\n    }\n  });\n\n  function atualizarPreviewElemento(imgId, textId, url) {\n    const img = document.getElementById(imgId);\n    const txt = document.getElementById(textId);\n    if (url) {\n      img.src = url;\n      img.classList.remove('escondido');\n      if (txt) txt.classList.add('escondido');\n    }\n  }\n\n  // TAXONOMIAS (TIPOS, CATEGORIAS, SUBCATEGORIAS)\n  async function carregarTaxonomias() {\n    try {\n      const querySnapshot = await getDocs(collection(db, \"taxonomias\"));\n      taxonomiasMemoria = [];\n      querySnapshot.forEach((docSnap) => {\n        taxonomiasMemoria.push({ id: docSnap.id, ...docSnap.data() });\n      });\n      preencherSelectsTaxonomia();\n      renderizarTagsTaxonomias();\n    } catch (e) {\n      console.error(\"Erro ao carregar categorias:\", e);\n    }\n  }\n\n  async function cadastrarTaxonomia() {\n    const tipo = document.getElementById('novoTipo').value.trim();\n    const categoria = document.getElementById('novaCategoria').value.trim();\n    const subcategoria = document.getElementById('novaSubcategoria').value.trim();\n\n    if (!tipo && !categoria && !subcategoria) {\n      mostrarToast(\"Preencha ao menos um campo para cadastrar!\", \"erro\");\n      return;\n    }\n\n    try {\n      await addDoc(collection(db, \"taxonomias\"), { tipo, categoria, subcategoria });\n      document.getElementById('novoTipo').value = '';\n      document.getElementById('novaCategoria').value = '';\n      document.getElementById('novaSubcategoria').value = '';\n      mostrarToast(\"Opção cadastrada com sucesso!\", \"sucesso\");\n      carregarTaxonomias();\n    } catch (e) {\n      mostrarToast(\"Erro ao cadastrar opção.\", \"erro\");\n    }\n  }\n\n  function preencherSelectsTaxonomia() {\n    const selTipo = document.getElementById('selectTipo');\n    const selCat = document.getElementById('selectCategoria');\n    const selSub = document.getElementById('selectSubcategoria');\n\n    const tipos = [...new Set(taxonomiasMemoria.map(t => t.tipo).filter(Boolean))];\n    const categorias = [...new Set(taxonomiasMemoria.map(t => t.categoria).filter(Boolean))];\n    const subcategorias = [...new Set(taxonomiasMemoria.map(t => t.subcategoria).filter(Boolean))];\n\n    selTipo.innerHTML = '<option value=\"\">Selecione o Tipo...</option>' + tipos.map(t => `<option value=\"${t}\">${t}</option>`).join('');\n    selCat.innerHTML = '<option value=\"\">Selecione a Categoria...</option>' + categorias.map(c => `<option value=\"${c}\">${c}</option>`).join('');\n    selSub.innerHTML = '<option value=\"\">Selecione a Subcategoria...</option>' + subcategorias.map(s => `<option value=\"${s}\">${s}</option>`).join('');\n  }\n\n  function renderizarTagsTaxonomias() {\n    const container = document.getElementById('listaTaxonomias');\n    container.innerHTML = '';\n    taxonomiasMemoria.forEach(item => {\n      const tag = document.createElement('span');\n      tag.className = 'badge-taxonomia';\n      tag.innerHTML = `${item.tipo || '—'} > ${item.categoria || '—'} > ${item.subcategoria || '—'} <button onclick=\"window.excluirTaxonomia('${item.id}')\">✕</button>`;\n      container.appendChild(tag);\n    });\n  }\n\n  window.excluirTaxonomia = async (id) => {\n    if(confirm(\"Excluir esta categoria cadastrada?\")) {\n      await deleteDoc(doc(db, \"taxonomias\", id));\n      carregarTaxonomias();\n    }\n  };\n\n  async function salvarConfiguracoesLoja() {\n    try {\n      const c = api.mesclarConfig(rascunho);\n      await setDoc(doc(db, \"configuracoes\", \"geral\"), {\n        logoUrl: logoUrlTemp,\n        faviconUrl: faviconUrlTemp,\n        nomeLoja: c.nomeLoja,\n        slogan: c.slogan,\n        tema: c.tema,\n        faixa: c.faixa,\n        atualizadoEm: new Date()\n      }, { merge: true });\n      await api.carregarConfiguracoesLoja();\n      carregarRascunho();\n      preencherIdentidade();\n      desenharPrevia();\n      marcarAlterado(false);\n      mostrarToast(\"Identidade visual salva!\", \"sucesso\");\n    } catch (e) { mostrarToast(\"Erro ao salvar.\", \"erro\"); }\n  }\n\n  const myWidget = cloudinary.createUploadWidget({\n      cloudName: CLOUD_NAME, uploadPreset: UPLOAD_PRESET, multiple: true, sources: ['local', 'url'], clientAllowedFormats: [\"png\", \"jpeg\", \"jpg\", \"webp\"]\n    }, (error, result) => { \n      if (!error && result && result.event === \"success\") {\n        let urlOtimizada = result.info.secure_url.replace('/upload/', '/upload/f_auto,q_auto,w_1200/');\n        listaImagensAtuais.push(urlOtimizada);\n        renderizarGridImagens();\n      }\n    }\n  );\n\n  document.getElementById(\"btnAbrirWidgetCloudinary\").onclick = () => myWidget.open();\n\n  function renderizarGridImagens() {\n    const grid = document.getElementById('gridImagens');\n    grid.innerHTML = `\n      <div class=\"box-add-imagem\" id=\"btnAbrirWidgetCloudinary\">\n        <span style=\"font-size: 1.5rem; color: var(--text-muted);\">＋</span>\n        <p style=\"font-size: 0.75rem; color: var(--text-muted);\">Adicionar Imagens</p>\n      </div>\n    `;\n    document.getElementById(\"btnAbrirWidgetCloudinary\").onclick = () => myWidget.open();\n\n    listaImagensAtuais.forEach((url, index) => {\n      const div = document.createElement('div');\n      div.className = 'item-img-grid';\n      div.dataset.indice = index;\n      div.innerHTML = `<img src=\"${esc(url)}\" alt=\"\" draggable=\"false\">\n        <span class=\"num-img ${index === 0 ? 'capa' : ''}\">${index === 0 ? 'Capa' : index + 1}</span>\n        ${index > 0 ? `<button type=\"button\" class=\"btn-primeira-img\" title=\"Colocar em primeiro\" aria-label=\"Colocar em primeiro\" onclick=\"window.moverImagemPrimeira(${index})\">⇧</button>` : ''}\n        <button type=\"button\" class=\"btn-remover-img\" aria-label=\"Remover imagem\" onclick=\"window.removerImagemGrid(${index})\">✕</button>`;\n      grid.appendChild(div);\n    });\n  }\n\n  window.moverImagemPrimeira = (index) => {\n    const [img] = listaImagensAtuais.splice(index, 1);\n    listaImagensAtuais.unshift(img);\n    renderizarGridImagens();\n    document.getElementById('gridImagens').scrollTop = 0;\n  };\n\n  // Arrastar para reordenar: com o mouse é só clicar e arrastar; no celular, segure a imagem um instante e arraste\n  function iniciarOrdenacaoImagens() {\n    const grid = document.getElementById('gridImagens');\n    let a = null;\n    const itens = () => Array.from(grid.querySelectorAll('.item-img-grid'));\n\n    function comecar() {\n      const r = a.item.getBoundingClientRect();\n      a.ativo = true;\n      a.dx = a.x - r.left;\n      a.dy = a.y - r.top;\n      const fantasma = a.item.cloneNode(true);\n      fantasma.classList.add('arrastando-fantasma');\n      fantasma.style.width = r.width + 'px';\n      fantasma.style.height = r.height + 'px';\n      document.body.appendChild(fantasma);\n      a.fantasma = fantasma;\n      a.item.classList.add('arrastando-origem');\n      document.body.classList.add('ordenando-imagens');\n      if (navigator.vibrate) navigator.vibrate(12);\n      mover();\n      a.rolagem = setInterval(rolar, 16);\n    }\n\n    function mover() {\n      a.fantasma.style.left = (a.x - a.dx) + 'px';\n      a.fantasma.style.top = (a.y - a.dy) + 'px';\n      const sob = document.elementFromPoint(a.x, a.y);\n      const alvo = sob && sob.closest('.item-img-grid');\n      if (alvo && alvo !== a.item && grid.contains(alvo)) {\n        const lista = itens();\n        if (lista.indexOf(alvo) > lista.indexOf(a.item)) alvo.after(a.item); else alvo.before(a.item);\n      }\n    }\n\n    function rolar() {   // perto da borda, a lista rola sozinha\n      const r = grid.getBoundingClientRect();\n      if (a.y < r.top + 36) grid.scrollTop -= 10;\n      else if (a.y > r.bottom - 36) grid.scrollTop += 10;\n      else return;\n      mover();\n    }\n\n    function terminar(confirmar) {\n      if (!a) return;\n      clearTimeout(a.timer);\n      clearInterval(a.rolagem);\n      window.removeEventListener('pointermove', aoMover);\n      window.removeEventListener('pointerup', aoSoltar);\n      window.removeEventListener('pointercancel', aoCancelar);\n      const ativo = a.ativo;\n      if (a.fantasma) a.fantasma.remove();\n      a.item.classList.remove('arrastando-origem');\n      document.body.classList.remove('ordenando-imagens');\n      if (ativo && confirmar) {\n        const ordem = itens().map((el) => Number(el.dataset.indice));\n        listaImagensAtuais = ordem.map((i) => listaImagensAtuais[i]);\n      }\n      a = null;\n      if (ativo) renderizarGridImagens();\n    }\n\n    function aoMover(e) {\n      if (!a || e.pointerId !== a.id) return;\n      a.x = e.clientX;\n      a.y = e.clientY;\n      if (!a.ativo) {\n        const distancia = Math.hypot(a.x - a.x0, a.y - a.y0);\n        if (a.tipo === 'mouse') { if (distancia > 6) comecar(); }\n        else if (distancia > 10) terminar(false);   // o dedo andou antes da espera: é rolagem, não arrasto\n        return;\n      }\n      mover();\n    }\n    const aoSoltar = (e) => { if (a && e.pointerId === a.id) terminar(true); };\n    const aoCancelar = (e) => { if (a && e.pointerId === a.id) terminar(false); };\n\n    grid.addEventListener('pointerdown', (e) => {\n      const item = e.target.closest('.item-img-grid');\n      if (!item || e.target.closest('button') || a) return;\n      if (e.pointerType === 'mouse' && e.button !== 0) return;\n      a = { item, id: e.pointerId, tipo: e.pointerType, x: e.clientX, y: e.clientY, x0: e.clientX, y0: e.clientY, ativo: false };\n      window.addEventListener('pointermove', aoMover);\n      window.addEventListener('pointerup', aoSoltar);\n      window.addEventListener('pointercancel', aoCancelar);\n      if (e.pointerType !== 'mouse') a.timer = setTimeout(() => { if (a && !a.ativo) comecar(); }, 280);\n    });\n    // Enquanto arrasta com o dedo, a tela não rola junto\n    grid.addEventListener('touchmove', (e) => { if (a && a.ativo) e.preventDefault(); }, { passive: false });\n    grid.addEventListener('contextmenu', (e) => { if (e.target.closest('.item-img-grid')) e.preventDefault(); });\n    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') terminar(false); });\n  }\n\n  window.removerImagemGrid = (index) => {\n    listaImagensAtuais.splice(index, 1);\n    renderizarGridImagens();\n  };\n\n  async function salvarCarrossel() {\n    const docId = document.getElementById('editDocId').value;\n    const titulo = document.getElementById('titulo').value;\n    const tipo = document.getElementById('selectTipo').value || 'Geral';\n    const categoria = document.getElementById('selectCategoria').value || 'Geral';\n    const subcategoria = document.getElementById('selectSubcategoria').value || 'Geral';\n    const descricao = sanitizarDescricao(document.getElementById('editorDescricao').innerHTML);\n    const preco = document.getElementById('preco').value;\n    const precoPromo = document.getElementById('precoPromo').value.trim();\n    const promoAteTxt = document.getElementById('promoAte').value;\n    const tags = extrairTags(document.getElementById('tagsProduto').value);\n    const link = document.getElementById('linkCompra').value.trim();\n\n    // Ao editar, deixar o link em branco = manter o link atual\n    if (!titulo || (!docId && !link)) {\n      mostrarToast(\"Preencha ao menos o Título e o Link!\", \"erro\");\n      return;\n    }\n\n    if (listaImagensAtuais.length === 0) {\n      mostrarToast(\"Adicione ao menos uma imagem!\", \"erro\");\n      return;\n    }\n\n    if (precoPromo) {\n      if (precoParaNumero(precoPromo) <= 0 || precoParaNumero(precoPromo) >= precoParaNumero(preco)) {\n        mostrarToast(\"O valor promocional precisa ser menor que o valor normal.\", \"erro\");\n        return;\n      }\n      if (promoAteTxt && new Date(promoAteTxt).getTime() <= Date.now()) {\n        mostrarToast(\"A data do fim da promoção precisa estar no futuro.\", \"erro\");\n        return;\n      }\n    }\n\n    const dados = { titulo, tipo, categoria, classe: subcategoria, descricao, preco, precoPromo: precoPromo || '', promoAte: (precoPromo && promoAteTxt) ? new Date(promoAteTxt).getTime() : null, tags, imagens: listaImagensAtuais, destaque: document.getElementById('chkDestaque').checked, criadoEm: new Date() };\n\n    try {\n      const ref = docId ? doc(db, \"produtos\", docId) : doc(collection(db, \"produtos\"));\n      // 1º o link vai para o cofre do Worker; só se der certo o produto é publicado\n      if (link) await chamarWorkerAdmin('/admin/salvar-link', { produtoId: ref.id, link });\n      if (docId) {\n        await updateDoc(ref, dados);\n      } else {\n        await setDoc(ref, dados);\n      }\n      mostrarToast(docId ? \"Carrossel atualizado!\" : \"Carrossel publicado!\", \"sucesso\");\n      cancelarEdicao();\n      carregarProdutos();\n    } catch (e) { mostrarToast(e.message || \"Erro ao salvar.\", \"erro\"); }\n  }\n\n  function prepararEdicao(id) {\n    const p = api.produtos().find(item => item.id === id);\n    if (!p) return;\n\n    selecionarAba('anuncio');\n    definirEstadoEdicao(p.titulo);\n    document.getElementById('editDocId').value = p.id;\n    document.getElementById('titulo').value = p.titulo;\n    document.getElementById('selectTipo').value = p.tipo || '';\n    document.getElementById('selectCategoria').value = p.categoria || '';\n    document.getElementById('selectSubcategoria').value = p.classe || '';\n    document.getElementById('editorDescricao').innerHTML = p.descricao || '';\n    document.getElementById('preco').value = p.preco;\n    document.getElementById('precoPromo').value = p.precoPromo || '';\n    document.getElementById('promoAte').value = p.promoAte ? paraCampoDataHora(Number(p.promoAte)) : '';\n    document.getElementById('tagsProduto').value = (p.tags || []).map((t) => '#' + t).join(' ');\n    atualizarInfoDesconto();\n    const campoLink = document.getElementById('linkCompra');\n    campoLink.value = '';\n    campoLink.placeholder = 'Carregando o link atual…';\n    chamarWorkerAdmin('/admin/ver-link', { produtoId: p.id })\n      .then((d) => { campoLink.value = d.link || ''; })\n      .catch(() => { campoLink.value = ''; })\n      .finally(() => { campoLink.placeholder = 'Em branco = manter o link atual'; });\n    document.getElementById('chkDestaque').checked = !!p.destaque;\n\n    listaImagensAtuais = [...(p.imagens || [])];\n    renderizarGridImagens();\n    atualizarPlaceholderEditor();\n\n    document.getElementById('btnSalvar').innerText = \"Atualizar Carrossel\";\n    document.getElementById('btnCancelarEdit').classList.remove('escondido');\n    window.scrollTo({ top: 0, behavior: 'smooth' });\n  }\n\n  function cancelarEdicao() {\n    definirEstadoEdicao(null);\n    document.getElementById('editDocId').value = '';\n    document.getElementById('titulo').value = '';\n    document.getElementById('selectTipo').value = '';\n    document.getElementById('selectCategoria').value = '';\n    document.getElementById('selectSubcategoria').value = '';\n    document.getElementById('editorDescricao').innerHTML = '';\n    document.getElementById('preco').value = '';\n    document.getElementById('precoPromo').value = '';\n    document.getElementById('promoAte').value = '';\n    document.getElementById('tagsProduto').value = '';\n    document.getElementById('infoDesconto').textContent = '';\n    textoAntesIA = null;\n    document.getElementById('btnDesfazerIA').classList.add('escondido');\n    document.getElementById('linkCompra').value = '';\n    document.getElementById('linkCompra').placeholder = 'https://seu-link.com';\n    document.getElementById('chkDestaque').checked = false;\n    listaImagensAtuais = [];\n    renderizarGridImagens();\n    atualizarPlaceholderEditor();\n\n    document.getElementById('btnSalvar').innerText = \"Publicar Carrossel\";\n    document.getElementById('btnCancelarEdit').classList.add('escondido');\n  }\n\n  // ===== PEDIDOS (painel do admin) =====\n  async function carregarPedidos() {\n    const lista = document.getElementById('listaPedidos');\n    const resumo = document.getElementById('pedidosResumo');\n    const btn = document.getElementById('btnPedidos');\n    btn.disabled = true; btn.textContent = 'Carregando...';\n    try {\n      const dados = await chamarWorkerAdmin('/admin/pedidos', {});\n      lista.innerHTML = '';\n      const pagos = dados.pedidos.filter(p => p.pago).length;\n      const semEntrega = dados.pedidos.filter(p => p.pago && !p.entregue).length;\n      const divergentes = dados.pedidos.filter(p => p.divergente).length;\n      resumo.textContent = `${dados.total} pedido(s) no total. Nos ${dados.pedidos.length} mais recentes: ${pagos} pagos` +\n        (semEntrega ? `, ${semEntrega} pago(s) ainda sem entrega confirmada` : '') +\n        (divergentes ? `, ${divergentes} com valor divergente` : '') + '.';\n      if (!dados.pedidos.length) { lista.textContent = 'Nenhum pedido ainda.'; return; }\n\n      const rotulo = { approved: 'Pago', pending: 'Aguardando', in_process: 'Em análise', rejected: 'Recusado',\n                       cancelled: 'Cancelado', aguardando: 'Aguardando', refunded: 'Reembolsado', charged_back: 'Contestado' };\n      dados.pedidos.forEach((p) => {\n        const item = document.createElement('div');\n        item.className = 'pedido-item';\n\n        const topo = document.createElement('div');\n        topo.className = 'pedido-topo';\n        const titulo = document.createElement('strong');\n        titulo.textContent = p.titulo || 'Arte';\n        const valor = document.createElement('span');\n        valor.textContent = Number(p.valor || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\n        topo.append(titulo, valor);\n\n        const etiquetas = document.createElement('div');\n        etiquetas.className = 'pedido-etiquetas';\n        const add = (texto, classe) => { const e = document.createElement('span'); e.className = 'pedido-tag ' + classe; e.textContent = texto; etiquetas.appendChild(e); };\n        add(rotulo[p.status] || p.status || '—', p.pago ? 'ok' : 'neutro');\n        add(p.tipo === 'cartao' ? 'Cartão' : 'Pix', 'neutro');\n        if (p.pago) add(p.entregue ? 'Entregue' : 'Sem entrega confirmada', p.entregue ? 'ok' : 'alerta');\n        if (p.emailEnviado) add('E-mail enviado', 'ok');\n        if (p.divergente) add('Valor divergente', 'erro');\n\n        const info = document.createElement('div');\n        info.className = 'pedido-info';\n        const quando = p.criadoEm ? new Date(p.criadoEm).toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) : '';\n        info.textContent = [quando, p.email || 'e-mail ainda não informado', p.pagamentoId ? `Pedido nº ${p.pagamentoId}` : ''].filter(Boolean).join(' · ');\n\n        item.append(topo, etiquetas, info);\n\n        if (p.pago && p.email && dados.emailAtivo) {\n          const reenviar = document.createElement('button');\n          reenviar.type = 'button';\n          reenviar.className = 'btn-link';\n          reenviar.textContent = 'Reenviar e-mail com o link';\n          reenviar.addEventListener('click', async () => {\n            reenviar.disabled = true;\n            try { await chamarWorkerAdmin('/admin/reenviar-email', { ped: p.ped }); mostrarToast('E-mail reenviado.', 'sucesso'); }\n            catch (e) { mostrarToast(e.message || 'Não foi possível enviar.', 'erro'); }\n            reenviar.disabled = false;\n          });\n          item.appendChild(reenviar);\n        }\n        lista.appendChild(item);\n      });\n    } catch (e) {\n      mostrarToast(e.message || 'Não foi possível carregar os pedidos.', 'erro');\n    } finally {\n      btn.disabled = false; btn.textContent = 'Atualizar pedidos';\n    }\n  }\n\n  async function excluirCarrossel(id) {\n    if (confirm(\"Remover este carrossel?\")) {\n      await deleteDoc(doc(db, \"produtos\", id));\n      try { await chamarWorkerAdmin('/admin/apagar-link', { produtoId: id }); } catch (e) { console.error(e); }\n      carregarProdutos();\n    }\n  }\n\n  async function alternarDestaque(prod) {\n    try {\n      await updateDoc(doc(db, \"produtos\", prod.id), { destaque: !prod.destaque });\n      mostrarToast(prod.destaque ? \"Destaque removido.\" : \"Anúncio em destaque!\", \"sucesso\");\n      carregarProdutos();\n    } catch (e) { mostrarToast(\"Erro ao alterar destaque.\", \"erro\"); }\n  }\n\n  // ---------- IDENTIDADE: nome, cores, faixa do topo e botões ----------\n  // As alterações aparecem na hora na loja (só neste navegador) e só valem para todos depois de salvar.\n  let rascunho = null;\n  let indiceIconeAtual = -1;\n  let widgetIconeBotao = null;\n  const el = (id) => document.getElementById(id);\n  const copiar = (o) => JSON.parse(JSON.stringify(o));\n  const urlBotaoOk = (u) => /^(https?:\\/\\/|mailto:|tel:)\\S+$/i.test(String(u || '').trim());\n\n  function marcarAlterado(sujo) { el('cfgAviso').classList.toggle('escondido', !sujo); }\n\n  function avisosDeContraste() {\n    const t = rascunho.tema, f = rascunho.faixa, cont = api.cores.contraste;\n    const avaliar = (rotulo, razao) => {\n      const r = razao.toFixed(1).replace('.', ',');\n      if (razao >= 4.5) return `✅ ${rotulo}: contraste ${r}:1 (ótimo)`;\n      if (razao >= 3) return `🟡 ${rotulo}: contraste ${r}:1 (aceitável)`;\n      return `⚠️ ${rotulo}: contraste ${r}:1 (baixo, fica difícil de ler)`;\n    };\n    const ini = f.corPropria ? f.corInicio : t.primaria;\n    const fim = f.corPropria ? f.corFim : t.secundaria;\n    const linhas = [\n      avaliar('Texto branco nos botões', cont('#FFFFFF', t.primaria)),\n      avaliar('Texto sobre o fundo da página', cont(t.texto, t.fundo)),\n      avaliar('Texto sobre os cartões brancos dos anúncios', cont(t.texto, '#FFFFFF')),\n      avaliar('Texto da faixa', Math.min(cont(f.corTexto, ini), cont(f.corTexto, fim)))\n    ];\n    el('cfgContraste').innerHTML = linhas.map((l) => `<div>${esc(l)}</div>`).join('');\n  }\n\n  function desenharPrevia() {\n    const c = api.mesclarConfig(rascunho);\n    const previa = el('cfgPrevia');\n    api.montarFaixa(previa, { ...c.faixa, visivel: true });          // a prévia sempre aparece\n    previa.classList.toggle('previa-oculta', !c.faixa.visivel);\n    avisosDeContraste();\n  }\n\n  function aplicarRascunho() {\n    api.aplicarConfiguracoesVisuais(rascunho);\n    desenharPrevia();\n    marcarAlterado(true);\n  }\n\n  // o seletor de ícones abre logo abaixo do botão que está sendo editado\n  function posicionarSeletorIcone() {\n    const seletor = el('cfgSeletorIcone');\n    const linhas = el('cfgBotoes').querySelectorAll('.botao-linha');\n    if (indiceIconeAtual >= 0 && linhas[indiceIconeAtual]) {\n      linhas[indiceIconeAtual].after(seletor);\n      seletor.scrollIntoView({ block: 'nearest', behavior: 'smooth' });\n    } else {\n      document.querySelector('#painelAdmin .id-faixa').appendChild(seletor);\n    }\n  }\n\n  function renderizarBotoes() {\n    const lista = el('cfgBotoes');\n    document.querySelector('#painelAdmin .id-faixa').appendChild(el('cfgSeletorIcone'));   // guarda o seletor antes de refazer a lista\n    lista.innerHTML = '';\n    rascunho.faixa.botoes.forEach((b, i) => {\n      const linha = document.createElement('div');\n      linha.className = 'botao-linha';\n\n      const icone = document.createElement('button');\n      icone.type = 'button';\n      icone.className = 'botao-icone';\n      icone.title = 'Trocar o ícone';\n      icone.setAttribute('aria-label', `Trocar o ícone do botão ${i + 1}`);\n      icone.appendChild(api.criarIconeBotao(b.icone));\n      icone.addEventListener('click', () => abrirSeletorIcone(i));\n\n      const rotulo = document.createElement('input');\n      rotulo.type = 'text';\n      rotulo.maxLength = 14;\n      rotulo.placeholder = 'Texto (opcional)';\n      rotulo.value = b.rotulo || '';\n      rotulo.setAttribute('aria-label', `Texto do botão ${i + 1}`);\n      rotulo.addEventListener('input', () => { b.rotulo = rotulo.value; aplicarRascunho(); });\n\n      const url = document.createElement('input');\n      url.type = 'text';\n      url.placeholder = 'https://link-do-botao.com';\n      url.value = b.url || '';\n      url.spellcheck = false;\n      url.setAttribute('aria-label', `Link do botão ${i + 1}`);\n      const validar = () => { const ruim = url.value.trim() !== '' && !urlBotaoOk(url.value); url.classList.toggle('invalido', ruim); url.title = ruim ? 'Use um endereço que comece com https://, mailto: ou tel:' : ''; };\n      url.addEventListener('input', () => { b.url = url.value.trim(); validar(); aplicarRascunho(); });\n      validar();\n\n      const acoes = document.createElement('div');\n      acoes.className = 'botao-acoes';\n      const mk = (txt, titulo, desabilitar, fn) => { const x = document.createElement('button'); x.type = 'button'; x.textContent = txt; x.title = titulo; x.setAttribute('aria-label', titulo); x.disabled = desabilitar; x.addEventListener('click', fn); return x; };\n      acoes.append(\n        mk('▲', 'Subir', i === 0, () => { const l = rascunho.faixa.botoes; [l[i - 1], l[i]] = [l[i], l[i - 1]]; renderizarBotoes(); aplicarRascunho(); }),\n        mk('▼', 'Descer', i === rascunho.faixa.botoes.length - 1, () => { const l = rascunho.faixa.botoes; [l[i + 1], l[i]] = [l[i], l[i + 1]]; renderizarBotoes(); aplicarRascunho(); }),\n        mk('✕', 'Remover botão', false, () => { rascunho.faixa.botoes.splice(i, 1); fecharSeletorIcone(); renderizarBotoes(); aplicarRascunho(); })\n      );\n\n      linha.append(icone, rotulo, url, acoes);\n      lista.appendChild(linha);\n    });\n    el('cfgAddBotao').disabled = rascunho.faixa.botoes.length >= 8;\n    posicionarSeletorIcone();\n  }\n\n  function abrirSeletorIcone(i) {\n    indiceIconeAtual = i;\n    const atual = rascunho.faixa.botoes[i].icone || {};\n    const grade = el('cfgIconeGrade');\n    grade.innerHTML = '';\n    Object.entries(api.icones).forEach(([chave, def]) => {\n      const b = document.createElement('button');\n      b.type = 'button';\n      b.className = 'icone-opcao';\n      b.title = def.nome;\n      b.setAttribute('aria-label', def.nome);\n      b.classList.toggle('ativo', atual.tipo === 'preset' && atual.valor === chave);\n      b.appendChild(api.criarIconeBotao({ tipo: 'preset', valor: chave }));\n      b.addEventListener('click', () => {\n        rascunho.faixa.botoes[i].icone = { tipo: 'preset', valor: chave };\n        fecharSeletorIcone();\n        renderizarBotoes();\n        aplicarRascunho();\n      });\n      grade.appendChild(b);\n    });\n    el('cfgEmoji').value = atual.tipo === 'emoji' ? atual.valor : '';\n    el('cfgSeletorIcone').classList.remove('escondido');\n    posicionarSeletorIcone();\n  }\n\n  function fecharSeletorIcone() {\n    indiceIconeAtual = -1;\n    el('cfgSeletorIcone').classList.add('escondido');\n    posicionarSeletorIcone();\n  }\n\n  function preencherIdentidade() {\n    const c = rascunho;\n    el('cfgNome').value = c.nomeLoja;\n    el('cfgSlogan').value = c.slogan;\n    [['cfgCorPrimaria', c.tema.primaria], ['cfgCorSecundaria', c.tema.secundaria], ['cfgCorFundo', c.tema.fundo], ['cfgCorTexto', c.tema.texto]].forEach(([id, v]) => {\n      el(id).value = v.toLowerCase();\n      el(id + 'Hex').value = v;\n      el(id + 'Hex').classList.remove('invalido');\n    });\n    el('cfgFaixaVisivel').checked = c.faixa.visivel;\n    el('cfgFaixaTitulo').value = c.faixa.titulo;\n    el('cfgFaixaTexto').value = c.faixa.texto;\n    el('cfgFaixaCorPropria').checked = c.faixa.corPropria;\n    el('cfgFaixaCorInicio').value = c.faixa.corInicio.toLowerCase();\n    el('cfgFaixaCorFim').value = c.faixa.corFim.toLowerCase();\n    el('cfgFaixaCorTexto').value = c.faixa.corTexto.toLowerCase();\n    atualizarCoresDaFaixa();\n    renderizarBotoes();\n  }\n\n  function atualizarCoresDaFaixa() {\n    const propria = el('cfgFaixaCorPropria').checked;\n    el('cfgFaixaCorInicio').disabled = !propria;\n    el('cfgFaixaCorFim').disabled = !propria;\n  }\n\n  function carregarRascunho() {\n    rascunho = copiar(api.mesclarConfig(api.configLoja()));\n  }\n\n  function iniciarIdentidade() {\n    carregarRascunho();\n    preencherIdentidade();\n    desenharPrevia();\n\n    el('cfgNome').addEventListener('input', () => { rascunho.nomeLoja = el('cfgNome').value; aplicarRascunho(); });\n    el('cfgSlogan').addEventListener('input', () => { rascunho.slogan = el('cfgSlogan').value; aplicarRascunho(); });\n\n    // as quatro cores do site: seletor de cor + código (#RRGGBB), sempre em sincronia\n    [['cfgCorPrimaria', 'primaria'], ['cfgCorSecundaria', 'secundaria'], ['cfgCorFundo', 'fundo'], ['cfgCorTexto', 'texto']].forEach(([id, chave]) => {\n      const cor = el(id), hex = el(id + 'Hex');\n      cor.addEventListener('input', () => { rascunho.tema[chave] = cor.value.toUpperCase(); hex.value = cor.value.toUpperCase(); hex.classList.remove('invalido'); aplicarRascunho(); });\n      hex.addEventListener('input', () => {\n        let v = hex.value.trim();\n        if (v && v[0] !== '#') v = '#' + v;\n        const valido = api.cores.hexValido(v, null);\n        hex.classList.toggle('invalido', !valido);\n        if (valido) { cor.value = valido.toLowerCase(); rascunho.tema[chave] = valido; aplicarRascunho(); }\n      });\n    });\n\n    // faixa\n    el('cfgFaixaVisivel').addEventListener('change', () => { rascunho.faixa.visivel = el('cfgFaixaVisivel').checked; aplicarRascunho(); });\n    el('cfgFaixaTitulo').addEventListener('input', () => { rascunho.faixa.titulo = el('cfgFaixaTitulo').value; aplicarRascunho(); });\n    el('cfgFaixaTexto').addEventListener('input', () => { rascunho.faixa.texto = el('cfgFaixaTexto').value; aplicarRascunho(); });\n    el('cfgFaixaCorPropria').addEventListener('change', () => { rascunho.faixa.corPropria = el('cfgFaixaCorPropria').checked; atualizarCoresDaFaixa(); aplicarRascunho(); });\n    [['cfgFaixaCorInicio', 'corInicio'], ['cfgFaixaCorFim', 'corFim'], ['cfgFaixaCorTexto', 'corTexto']].forEach(([id, chave]) => {\n      el(id).addEventListener('input', () => { rascunho.faixa[chave] = el(id).value.toUpperCase(); aplicarRascunho(); });\n    });\n\n    // botões da faixa\n    el('cfgAddBotao').addEventListener('click', () => {\n      if (rascunho.faixa.botoes.length >= 8) return;\n      rascunho.faixa.botoes.push({ rotulo: '', url: '', icone: { tipo: 'preset', valor: 'site' } });\n      renderizarBotoes();\n      aplicarRascunho();\n      const campos = el('cfgBotoes').querySelectorAll('.botao-linha');\n      campos[campos.length - 1].querySelectorAll('input')[1].focus();\n    });\n    el('cfgIconeFechar').addEventListener('click', fecharSeletorIcone);\n    el('cfgEmoji').addEventListener('input', () => {\n      const valor = Array.from(el('cfgEmoji').value.trim()).slice(0, 2).join('');\n      if (indiceIconeAtual < 0 || !valor) return;\n      rascunho.faixa.botoes[indiceIconeAtual].icone = { tipo: 'emoji', valor };\n      renderizarBotoes();\n      aplicarRascunho();\n    });\n    el('cfgIconeImagem').addEventListener('click', () => {\n      if (!widgetIconeBotao) {\n        widgetIconeBotao = cloudinary.createUploadWidget({\n          cloudName: CLOUD_NAME, uploadPreset: UPLOAD_PRESET, multiple: false, sources: ['local', 'url'],\n          clientAllowedFormats: ['png', 'jpeg', 'jpg', 'webp', 'svg']\n        }, (erro, resultado) => {\n          if (erro || !resultado || resultado.event !== 'success' || indiceIconeAtual < 0) return;\n          const url = resultado.info.format === 'svg' ? resultado.info.secure_url : resultado.info.secure_url.replace('/upload/', '/upload/c_limit,w_96/');\n          rascunho.faixa.botoes[indiceIconeAtual].icone = { tipo: 'imagem', valor: url };\n          fecharSeletorIcone();\n          renderizarBotoes();\n          aplicarRascunho();\n        });\n      }\n      widgetIconeBotao.open();\n    });\n\n    // restaurar / descartar\n    el('btnCoresPadrao').addEventListener('click', () => { rascunho.tema = copiar(api.configPadrao().tema); preencherIdentidade(); aplicarRascunho(); });\n    el('btnFaixaPadrao').addEventListener('click', () => { rascunho.faixa = copiar(api.configPadrao().faixa); fecharSeletorIcone(); preencherIdentidade(); aplicarRascunho(); });\n    el('btnDescartarConfig').addEventListener('click', () => {\n      carregarRascunho();\n      fecharSeletorIcone();\n      preencherIdentidade();\n      api.aplicarConfiguracoesVisuais(rascunho);\n      desenharPrevia();\n      marcarAlterado(false);\n    });\n  }\n\n  // ---------- abas do painel ----------\n  let pedidosJaCarregados = false;\n\n  function selecionarAba(nome) {\n    document.querySelectorAll('#painelAdmin .painel-aba-btn').forEach((b) => {\n      const ativa = b.dataset.aba === nome;\n      b.classList.toggle('ativa', ativa);\n      b.setAttribute('aria-selected', ativa ? 'true' : 'false');\n      b.tabIndex = ativa ? 0 : -1;\n    });\n    document.querySelectorAll('#painelAdmin .painel-secao').forEach((s) => {\n      const ativa = s.dataset.aba === nome;\n      s.classList.toggle('ativa', ativa);\n      s.hidden = !ativa;\n    });\n    if (nome === 'pedidos' && !pedidosJaCarregados) { pedidosJaCarregados = true; carregarPedidos(); }\n  }\n\n  function iniciarAbas() {\n    const abas = Array.from(document.querySelectorAll('#painelAdmin .painel-aba-btn'));\n    abas.forEach((b) => b.addEventListener('click', () => selecionarAba(b.dataset.aba)));\n    document.querySelector('#painelAdmin .painel-abas').addEventListener('keydown', (e) => {\n      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;\n      const i = abas.findIndex((b) => b.classList.contains('ativa'));\n      const proxima = abas[(i + (e.key === 'ArrowRight' ? 1 : -1) + abas.length) % abas.length];\n      selecionarAba(proxima.dataset.aba);\n      proxima.focus();\n    });\n  }\n\n  // etiqueta \"Editando\" junto aos dados do anúncio (some quando não há edição)\n  function definirEstadoEdicao(titulo) {\n    const e = document.getElementById('painelEstado');\n    e.textContent = titulo ? '✏️ Editando' : '';\n    e.classList.toggle('escondido', !titulo);\n  }\n\n  // ---------- ligações do painel ----------\n  document.getElementById('btnFazerLogout').addEventListener('click', () => api.sair());\n  document.getElementById('btnSalvar').addEventListener('click', salvarCarrossel);\n  document.getElementById('btnCancelarEdit').addEventListener('click', cancelarEdicao);\n  document.getElementById('btnUploadLogo').addEventListener('click', () => widgetLogo.open());\n  document.getElementById('btnUploadFavicon').addEventListener('click', () => widgetFavicon.open());\n  document.getElementById('btnSalvarConfig').addEventListener('click', salvarConfiguracoesLoja);\n  document.getElementById('btnCadastrarTaxonomia').addEventListener('click', cadastrarTaxonomia);\n  document.getElementById('btnPedidos').addEventListener('click', carregarPedidos);\n\n  iniciarAbas();\n  iniciarIdentidade();\n  iniciarEditorTexto();\n  iniciarOrdenacaoImagens();\n\n  aplicarMascaraMoeda(document.getElementById('preco'));\n  aplicarMascaraMoeda(document.getElementById('precoPromo'));\n  document.getElementById('preco').addEventListener('input', atualizarInfoDesconto);\n  document.getElementById('precoPromo').addEventListener('input', atualizarInfoDesconto);\n\n  // botões Editar / Excluir / Destacar que aparecem nos cards da vitrine\n  api.ganchos.cardAdmin = (prod, corpo) => {\n    const caixa = document.createElement('div');\n    caixa.className = 'acoes-admin';\n    caixa.innerHTML = `<button class=\"btn-editar\">Editar</button>\n      <button class=\"btn-excluir\">Excluir</button>\n      <button class=\"btn-destacar\">${prod.destaque ? '★ Tirar dos destaques' : '☆ Destacar na loja'}</button>`;\n    caixa.querySelector('.btn-editar').addEventListener('click', () => prepararEdicao(prod.id));\n    caixa.querySelector('.btn-excluir').addEventListener('click', () => excluirCarrossel(prod.id))